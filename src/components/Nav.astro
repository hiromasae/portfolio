---
import { contacts } from '../data/projects';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const onHome = path === '/';
const onAbout = path === '/about' || path === '/about/';
// The home page is the projects listing, and project detail pages live under
// the Projects section, so the Projects nav link is the active one on both.
const onProject = onHome || path.startsWith('/projects/');

---

<nav
	id="site-nav"
	data-home={onHome ? 'true' : 'false'}
	class="sticky top-0 z-40 bg-[var(--paper)]"
>
	{/* The bar's whole geometry — vertical padding (height), wordmark/links
	    scale, icon close-ranks slide — derives from one progress value --q
	    (0 = expanded masthead, 1 = compact bar) via calc() in global.css. On
	    the home page --q is scrubbed 1:1 from scrollY by the scripts below, so
	    bar and contents move together with the scroll itself: one unit, no
	    animation clock. */}
	<div class="nav-pad mx-auto max-w-[1280px] px-5">
		{/* No flex gap here: it would also open up between the contact group and
		    the theme toggle, breaking the compact close-ranks math in global.css
		    (which assumes one uniform 0.375rem gap between all buttons). The
		    logo↔links gap lives in the links' ml-7 instead. */}
		<div class="nav-inner flex items-center">
			{/* Left cluster: wordmark + links compact as ONE unit — the wrapper
			    carries the logo's scale (q-driven, see .nav-left in global.css),
			    so the links and the whitespace before them shrink in exact
			    proportion to the wordmark through pure layout (no JS width
			    measurement, so no dependence on which font has loaded). The links
			    counter-scale inside the shrunken wrapper (see .nav-links in
			    global.css) to land at their own, larger compact size and stay
			    readable. */}
			<div class="nav-left flex origin-left items-center">
				<a href="/" class="nav-logo text-[2.5rem] font-bold tracking-tight text-[var(--ink)]">
					Hiro Eernisse
				</a>

				{/* Projects/About sit right beside the wordmark. The link for the
				    section you're on is marked active with aria-current (styled in
				    global.css). */}
				<div class="nav-links ml-7 hidden origin-left items-center gap-1 text-xl font-medium text-[var(--ink-soft)] sm:flex">
					<a
						href="/#projects"
						data-projects-link
						data-nav-link="projects"
						class="rounded-none px-2 py-1 transition-colors hover:text-[var(--ink)]"
						aria-current={onProject ? 'page' : undefined}
					>Projects</a>
					<a
						href="/about"
						data-nav-link="about"
						class="rounded-none px-2 py-1 transition-colors hover:text-[var(--ink)]"
						aria-current={onAbout ? 'page' : undefined}
					>About</a>
					{/* One shared underline that glides between the two links: it rests
					    under the active section, follows the cursor on hover/focus and
					    springs back on leave, and slides from the old link to the new one
					    across a Projects↔About navigation (replayed by the inline script
					    below). Positioned entirely by script; a CSS fallback under each
					    active link covers the no-JS case (see global.css). */}
					<span class="nav-underline" aria-hidden="true"></span>
				</div>
			</div>

		<div id="contact-group" class="relative ml-auto flex items-center gap-1.5 self-center">
			{
				contacts.map((c, i) => {
					const isEmail = c.href.startsWith('mailto:');
					const hoverLabel = isEmail ? 'Copy email' : c.label;
					return (
						<a
							href={c.href}
							class="btn-icon"
							style={`--nav-icon-r: ${contacts.length - i}`}
							aria-label={hoverLabel}
							data-label={hoverLabel}
							data-copy={isEmail ? c.href.replace('mailto:', '') : undefined}
							target={isEmail ? undefined : '_blank'}
							rel="noopener"
						>
							<Icon name={c.icon} />
						</a>
					);
				})
			}
			{/* One shared ink pill that glides between the icons on hover/focus,
			    carrying the hovered icon's label. Positioned entirely by script.
			    The ↗ shows only for external (new-tab) links. */}
			<span class="contact-slider" aria-hidden="true">
				<span class="contact-slider-text"></span>
				<svg
					class="contact-slider-ext"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="square"
					stroke-linejoin="miter"
					aria-hidden="true"
				>
					<path d="M15 3h6v6" />
					<path d="M10 14 21 3" />
					<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
				</svg>
			</span>
		</div>

		{/* Light/dark toggle: boxed by a quiet border (no fill), which sets it
		    apart from the borderless contact icons without outshouting them —
		    as does its wider ml-6 gap. The compact close-ranks slide in
		    global.css hard-codes both gaps (contact-group's gap-1.5 and this
		    ml-6); keep them in step. */}
		<button
			id="theme-toggle"
			type="button"
			class="btn-icon theme-toggle ml-6 self-center"
			aria-label="Toggle light and dark theme"
		>
			{/* Two glyphs grid-stacked in one cell; only the icon for the theme you'd
			    switch TO is shown (moon in light, sun in dark), swapped by opacity +
			    a scale pop. See the theme-swap block in global.css. */}
			<svg
				class="icon-moon"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="square"
				stroke-linejoin="miter"
				aria-hidden="true"
			>
				<path d="M20 14.5A8 8 0 1 1 12.5 4a6.5 6.5 0 0 0 7.5 10.5Z" />
			</svg>
			<svg
				class="icon-sun"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="square"
				stroke-linejoin="miter"
				aria-hidden="true"
			>
				<circle cx="12" cy="12" r="3.6" />
				<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
			</svg>
		</button>
		</div>
	</div>
</nav>

<script is:inline>
	// ── Scroll-driven masthead: the q model ──
	// One progress value q (0 = expanded masthead, 1 = compact bar) drives the
	// nav's entire geometry through calc() in global.css — vertical padding,
	// wordmark/links scale, icon close-ranks slide are all functions of q, so
	// the bar and its contents move as one unit BY CONSTRUCTION. On the home
	// page q is scrubbed 1:1 from scrollY (no thresholds, no timed animation:
	// the bar tracks a wheel notch exactly as fast as the page scrolls);
	// interior pages pin q to 1.
	//
	// This inline script owns everything that must happen pre-paint:
	//   - paint this load's q (from scrollY — or the q carried across an MPA
	//     navigation, so interior→home-top tweens open instead of snapping)
	//   - the projects-landing intent (position the page before first paint)
	//   - the cross-page intro: tween q to its resting value at 'interactive'
	//     (readyState 'interactive' fires before module scripts evaluate, so
	//     the intro can't be starved by the module chain — in dev, the Vite
	//     client — on a slow round trip)
	// The live scroll scrubbing lives in the module script below, which reuses
	// window.__navQ installed here: one source for the q math.
	(function () {
		var nav = document.getElementById('site-nav');
		if (!nav) return;
		var onHome = nav.dataset.home === 'true';
		var root = document.documentElement;
		// Full-collapse scroll distance = the masthead's height delta (the
		// --nav-shift the page rides on in global.css, 5.5rem) — the masthead
		// collapse tracks the scroll exactly 1:1. Keep in step with the CSS,
		// including the animation-range of the compositor scrub there.
		var RANGE = 5.5 * (parseFloat(getComputedStyle(root).fontSize) || 19);
		var LOGO =
			parseFloat(getComputedStyle(nav).getPropertyValue('--nav-logo-scale')) || 0.42;
		var LINKS =
			parseFloat(getComputedStyle(nav).getPropertyValue('--nav-links-scale')) || 0.702;
		// On supporting browsers the home-page geometry is bound straight to the
		// scroll offset by the compositor (the scroll-driven animations in
		// global.css) — the JS scrub then only maintains bookkeeping (--q for
		// the intro handoff, persistence, landing math).
		var TIMELINE =
			onHome && !!(window.CSS && CSS.supports && CSS.supports('animation-timeline: scroll()'));
		var q = onHome ? 0 : 1; // matches the stylesheet default before the first setQ

		// Set q (vars live on <html>: main/footer ride --q too). The links'
		// counter-scale is a NONLINEAR function of q (they must land at a net
		// --nav-links-scale while riding inside the wrapper's --nav-logo-scale),
		// so it can't be a pure calc() — both vars are set together here, the
		// single writer. Keep the formula in step with the nav-scrub-links
		// keyframes in global.css.
		var setQ = function (v) {
			v = Math.max(0, Math.min(1, v));
			q = v;
			root.style.setProperty('--q', String(v));
			root.style.setProperty(
				'--q-links',
				((1 - (1 - LINKS) * v) / (1 - (1 - LOGO) * v)).toFixed(5)
			);
		};
		var qFromScroll = function () {
			return onHome ? Math.max(0, Math.min(1, window.scrollY / RANGE)) : 1;
		};
		// The q the PAINTED geometry currently reflects: with the compositor
		// scrub active the visuals follow the scroll offset directly (whatever
		// --q says); while html.nav-intro detaches it — or without timeline
		// support at all — the visuals follow --q.
		var qPainted = function () {
			return TIMELINE && !root.classList.contains('nav-intro') ? qFromScroll() : q;
		};
		// The bar's current VISUAL height: its layout box is pinned compact, and
		// the masthead's extra height is the page shift still un-collapsed.
		var visualNavH = function () {
			return nav.offsetHeight + RANGE * (1 - qPainted());
		};
		// Shared with the module script's scrub handler.
		window.__navQ = {
			setQ: setQ,
			range: RANGE,
			get: function () {
				return q;
			},
			fromScroll: qFromScroll,
			visualNavH: visualNavH,
		};

		window.addEventListener('pagehide', function () {
			try {
				sessionStorage.setItem('nav-q', q.toFixed(4) + ':' + Date.now());
			} catch (e) {}
		});

		// A pending "show projects" intent — set when a projects link is clicked on
		// another page. The flag holds '1' for the top of the list or a project
		// slug for a specific card. Handled entirely here, not in the module
		// script: the nav paints compact up front (no flash of the tall masthead)
		// and the scroll to the projects view runs at 'interactive' — before any
		// module script, and before first paint in practice — so the page opens
		// already resting on the target instead of visibly jumping to it.
		var projectsIntent = null;
		if (onHome) {
			try {
				projectsIntent = sessionStorage.getItem('nav-projects');
				sessionStorage.removeItem('nav-projects');
			} catch (e) {}
		}
		// An exact return position — recorded (as "slug:y") by the module script
		// when a project card is opened from the list — so "Back to projects"
		// restores the very scroll position the visitor left, not just the card
		// aligned under the nav. Honored only when the intent names the same
		// project the position was recorded for (a detail page reached some other
		// way falls back to the card alignment), and consumed on use so a stale
		// entry can't hijack a later landing.
		var returnY = null;
		if (projectsIntent && projectsIntent !== '1') {
			try {
				var ret = sessionStorage.getItem('nav-return');
				if (ret) {
					var retSep = ret.indexOf(':');
					if (ret.slice(0, retSep) === projectsIntent) {
						returnY = Math.max(0, +ret.slice(retSep + 1) || 0);
						sessionStorage.removeItem('nav-return');
					}
				}
			} catch (e) {}
		}
		// Curtain for the landing (see global.css): first paint can beat both the
		// 'interactive' scroll below and the browser's own fragment scroll, which
		// would flash the top of the page for a frame before snapping down to the
		// card. Content stays hidden until positioned; arrive() always lifts it.
		if (projectsIntent) document.documentElement.classList.add('projects-landing');
		// This load's resting q: from the exact remembered position, the projects
		// view (≈ fully compact), or wherever the browser put us.
		var restY = projectsIntent ? (returnY !== null ? returnY : RANGE) : window.scrollY;
		var restQ = onHome ? Math.max(0, Math.min(1, restY / RANGE)) : 1;

		// The q carried over from the page we just left, if fresh. The age cap
		// means returning to a stale tab (e.g. from an external site much later)
		// paints at rest instead of replaying an old tween.
		var carried = null;
		try {
			var raw = sessionStorage.getItem('nav-q');
			sessionStorage.removeItem('nav-q');
			if (raw) {
				var sep = raw.lastIndexOf(':');
				if (Date.now() - +raw.slice(sep + 1) < 10000) carried = +raw.slice(0, sep);
			}
		} catch (e) {}
		if (carried !== null && !(carried >= 0 && carried <= 1)) carried = null;

		var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		var animate = !reduce && carried !== null && Math.abs(carried - restQ) > 0.02;

		// Paint pre-paint at the starting q (carried if tweening, else rest).
		// A pending intro detaches the compositor scrub NOW, pre-paint, so the
		// first frame shows the carried --q geometry, not the scroll-derived one.
		if (animate) root.classList.add('nav-intro');
		setQ(animate ? carried : restQ);
		if (!animate && !projectsIntent) return;

		// Land on the projects view: the exact remembered position when we have
		// one, otherwise the intended card (or the top of the list) ~12px under
		// the compact bar (a one-shot copy of goToProjects in the module script
		// below — keep the two in step). For a card, the browser's native
		// fragment scroll has already positioned the page pre-paint (the link
		// navigates to /#project-<slug>); this settles the final position and
		// drops the hash off the URL. 'instant' overrides the stylesheet's
		// `scroll-behavior: smooth`; a landing must not glide.
		var landOnProjects = function () {
			if (returnY !== null) {
				window.scrollTo({ top: returnY, behavior: 'instant' });
			} else {
				var el =
					(projectsIntent !== '1' && document.getElementById('project-' + projectsIntent)) ||
					document.getElementById('project-list');
				if (el) {
					// The bar's VISUAL height on purpose: the element's rect rides
					// the page shift, and rect − visualH is q-invariant, so this is
					// the right target whatever q is painted right now (mirrors
					// compactTargetY in the module script below — keep in step).
					var y = el.getBoundingClientRect().top + window.scrollY - visualNavH() - 12;
					window.scrollTo({ top: Math.max(y, 0), behavior: 'instant' });
				}
			}
			setQ(qFromScroll()); // q must agree with wherever we landed
			if (location.hash) history.replaceState(null, '', '/');
		};

		// Cross-page intro: tween q from the carried value to rest. rAF-driven
		// (not a CSS transition) because --q-links is a nonlinear function of q
		// that only setQ can keep exact. The ease approximates the old
		// --nav-ease decel. While it runs, html.nav-intro keeps the compositor
		// scrub detached so --q owns the geometry; finishing (or the user's own
		// scrolling, which aborts it) hands back at the scroll-derived value —
		// the same geometry, so the switch is invisible.
		var runIntro = function () {
			var from = q;
			// Recompute rest instead of reusing restQ: back/forward scroll
			// restoration can land before this runs (e.g. returning to a
			// scrolled-down home), and the restored position may already match.
			var to = qFromScroll();
			var finish = function () {
				setQ(qFromScroll());
				root.classList.remove('nav-intro');
			};
			if (Math.abs(from - to) < 0.02) {
				finish();
				return;
			}
			var aborted = false;
			var onScroll = function () {
				aborted = true;
				window.removeEventListener('scroll', onScroll);
				finish();
			};
			window.addEventListener('scroll', onScroll, { passive: true });
			var t0 = performance.now();
			var step = function (now) {
				if (aborted) return;
				var t = Math.min(1, (now - t0) / 200);
				var e = 1 - Math.pow(1 - t, 3); // ease-out cubic
				setQ(from + (to - from) * e);
				if (t < 1) {
					requestAnimationFrame(step);
				} else {
					window.removeEventListener('scroll', onScroll);
					finish();
				}
			};
			requestAnimationFrame(step);
		};

		// 'interactive' means main and the cards exist and layout is measurable;
		// it fires before module scripts evaluate. The landing scroll runs first
		// so runIntro's recomputed resting q sees the final scroll position.
		var arrive = function () {
			if (projectsIntent) {
				try {
					landOnProjects();
				} finally {
					document.documentElement.classList.remove('projects-landing');
				}
			}
			if (animate) runIntro();
		};
		if (document.readyState !== 'loading') {
			arrive();
		} else {
			document.addEventListener('readystatechange', function onReady() {
				document.removeEventListener('readystatechange', onReady);
				arrive();
			});
		}
	})();
</script>

<script is:inline>
	// ── Sliding nav-link underline (cross-page arrival) ──
	// Like the nav's collapse animation, the underline's Projects↔About slide
	// can't tween across an MPA page load on its own. So we persist where the
	// underline was sitting when a page is left, and on arrival diff it against
	// this page's active link: same machinery as the nav-state script above.
	//
	//   1. pagehide: store the link the underline currently sits under (which the
	//      hover/focus handlers keep up to date), NOT just this page's active
	//      link. If the visitor hovered the link they then clicked, the underline
	//      already slid there — so the destination must start from THAT spot, or
	//      it would visibly reset and replay the same slide a second time.
	//   2. On arrival: find this page's active link. Paint the underline resting
	//      under it — unless a fresh, DIFFERENT spot was carried over, in which
	//      case paint it under the OLD spot and release it to slide to the new
	//      one. (Hover-then-click lands with carried === active → no replay; a
	//      navigation that didn't touch the nav, e.g. a project card, still
	//      slides.)
	//
	// Runs inline (pre-paint) so the underline is placed before first paint: no
	// flash of it at the destination before the slide, and adding `has-slider`
	// here retires the CSS fallback underline in the same frame. Measurements use
	// offsetLeft/offsetWidth (untransformed layout space), so they're unaffected
	// by the compact scale and identical on both pages.
	(function () {
		var links = document.querySelector('#site-nav .nav-links');
		if (!links) return;
		var underline = links.querySelector('.nav-underline');
		var items = links.querySelectorAll('a[data-nav-link]');
		if (!underline || !items.length) return;
		// JS is driving the slider now — drop the per-link CSS fallback underline.
		links.classList.add('has-slider');

		var active = null;
		var activeKey = null;
		for (var i = 0; i < items.length; i++) {
			if (items[i].getAttribute('aria-current') === 'page') {
				active = items[i];
				activeKey = items[i].getAttribute('data-nav-link');
			}
		}
		if (!active) return;

		// Place the underline under `link`. With animate=false the move is snapped
		// (transitions suppressed and flushed) so it can't tween from a stale
		// spot; with animate=true it rides the CSS transition and glides.
		var place = function (link, animate) {
			// Record which link the underline now sits under, so pagehide can carry
			// the live position across the navigation (the module hover handlers
			// update this too — keep the two in step).
			underline.dataset.at = link.getAttribute('data-nav-link') || '';
			var cs = getComputedStyle(link);
			var padL = parseFloat(cs.paddingLeft) || 0;
			var padR = parseFloat(cs.paddingRight) || 0;
			var x = link.offsetLeft + padL;
			var w = Math.max(0, link.offsetWidth - padL - padR);
			if (!animate) underline.style.transition = 'none';
			underline.style.transform = 'translateX(' + x + 'px)';
			underline.style.width = w + 'px';
			if (!animate) {
				void underline.offsetWidth;
				underline.style.transition = '';
			}
		};

		// Where the underline sat on the page we just left — the slide's starting
		// point, if fresh and different from this page's active link.
		var from = null;
		try {
			var raw = sessionStorage.getItem('nav-underline');
			sessionStorage.removeItem('nav-underline');
			if (raw) {
				var sep = raw.lastIndexOf(':');
				var key = raw.slice(0, sep);
				if (Date.now() - +raw.slice(sep + 1) < 10000 && key !== activeKey) {
					from = links.querySelector('a[data-nav-link="' + key + '"]');
				}
			}
		} catch (e) {}

		// Carry the underline's live spot to the next page — captured when the
		// visitor COMMITS a navigation (a link click), not on pagehide. By pagehide
		// the link has lost focus and the unload-time focus/hover springback has
		// already snapped the underline back to the active link, which was
		// overwriting the carried spot and making the destination replay a slide
		// the visitor had just seen on hover. The bubble phase runs after each
		// link's own handler, so a click that only scrolls in place (the Projects
		// link on home calls preventDefault) is skipped, as are new-tab/modified
		// clicks that don't navigate this tab.
		document.addEventListener('click', function (e) {
			var a = e.target && e.target.closest && e.target.closest('a[href]');
			if (!a || e.defaultPrevented) return;
			if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
			try {
				sessionStorage.setItem(
					'nav-underline',
					(underline.dataset.at || activeKey) + ':' + Date.now()
				);
			} catch (err) {}
		});

		var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (from && !reduce) {
			place(from, false); // paint under the old spot, style flushed
			// Mark the arrival slide in flight so the module's font/resize realign
			// doesn't snap it straight to the end (see restUnderline below).
			underline.dataset.sliding = '1';
			underline.addEventListener('transitionend', function done() {
				underline.dataset.sliding = '';
				underline.removeEventListener('transitionend', done);
			});
			// Release on the next frame so the transition animates from the
			// flushed 'from' state to the active link rather than snapping.
			requestAnimationFrame(function () {
				place(active, true);
			});
		} else {
			place(active, false); // no slide to replay — just rest under active
		}
	})();
</script>

<script>
	// ── Theme toggle ──
	// Flip <html data-theme> and remember the manual choice. The initial theme
	// is resolved pre-paint in Layout.astro; this only handles user clicks.
	const themeToggle = document.getElementById('theme-toggle');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const syncThemeLabel = () => {
		const dark = document.documentElement.dataset.theme === 'dark';
		themeToggle?.setAttribute(
			'aria-label',
			dark ? 'Switch to light theme' : 'Switch to dark theme',
		);
	};
	syncThemeLabel();
	themeToggle?.addEventListener('click', () => {
		const root = document.documentElement;
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		// Suppress every transition for the frame the theme flips so the whole
		// page changes at once — no element animates on its own clock, and grey
		// text never dips through a low-contrast mid-tone. Force a style flush
		// with transitions off, then re-enable them on the next frame.
		root.classList.add('theme-switching');
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch (e) {}
		syncThemeLabel();
		// Play the sun/moon swap. It's a keyframe animation (unaffected by the
		// transition suppression above), retriggered by removing the class and
		// forcing a reflow before re-adding so rapid clicks restart it cleanly.
		if (themeToggle && !prefersReducedMotion.matches) {
			themeToggle.classList.remove('theme-anim');
			void themeToggle.offsetWidth;
			themeToggle.classList.add('theme-anim');
		}
		void root.offsetHeight;
		requestAnimationFrame(() => root.classList.remove('theme-switching'));
	});

	const nav = document.getElementById('site-nav');
	// The q machinery (scroll → geometry) is installed pre-paint by the inline
	// script above — see there for the model. This module adds the live scroll
	// scrubbing and the projects-link behaviours.
	const navQ = (window as any).__navQ;
	if (nav && navQ) {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// ── "Projects" → projects section ──
		// The projects list is the top of the home page, sitting directly under
		// the masthead. A plain #projects anchor lands too near the top (the bar
		// would sit mid-collapse); instead we scroll to the spot where the bar is
		// fully compact and the first card sits just beneath it. Cross-page, a
		// sessionStorage flag carries the intent so the home page lands there
		// directly (see the inline script's `projectsIntent`).
		const PROJECTS_FLAG = 'nav-projects';

		// The y that rests `el` ~12px under the bar (mirrored by the inline
		// script's `landOnProjects` — keep the two in step). Uses the bar's
		// current VISUAL height on purpose: the element's rect rides the page
		// shift, and the two change together as q does, so their difference is
		// q-invariant — the same answer at any scroll state, including the
		// final one.
		const compactTargetY = (el) => {
			const top = el.getBoundingClientRect().top + window.scrollY - navQ.visualNavH();
			return Math.max(top - 12, 0);
		};

		// The settle (below) only ever finishes a USER gesture. A programmatic
		// scroll — the projects landing, goToProjects — may deliberately rest
		// mid-range (the list sits so high that a fully-compact bar is
		// geometrically impossible there); settling would yank that designed
		// position away. Suppressed until the next real input. A mid-range q at
		// module init means the pre-paint landing already positioned us.
		let allowSettle = !(navQ.get() > 0 && navQ.get() < 1);
		const armSettle = () => {
			allowSettle = true;
		};
		window.addEventListener('wheel', armSettle, { passive: true });
		window.addEventListener('touchstart', armSettle, { passive: true });
		window.addEventListener('keydown', armSettle);

		// Scroll to the projects view — a specific card when `slug` names one
		// (Back-to-projects returns you to the card you came from), otherwise the
		// top of the list.
		const goToProjects = (smooth, slug) => {
			const target =
				(slug && document.getElementById(`project-${slug}`)) ||
				document.getElementById('project-list');
			if (!target) return;
			allowSettle = false; // this glide's resting spot is the destination
			// 'instant', not 'auto': the stylesheet's `scroll-behavior: smooth`
			// turns 'auto' into a glide, and the landing snap must not animate.
			window.scrollTo({
				top: compactTargetY(target),
				behavior: smooth && !reduceMotion ? 'smooth' : 'instant',
			});
		};

		// Intercept every projects link (nav "Projects", "Back to projects"). On
		// home we scroll in place. From elsewhere we stash the intent — '1' for the
		// top of the list, or a slug for a specific card — and navigate. A slug
		// intent keeps the card's #fragment on the URL: the browser's native
		// fragment scroll positions the page *during parsing*, before first paint,
		// so the landing opens on the card with no visible jump (the inline
		// script's landOnProjects then settles the exact position — a remembered
		// return spot when one exists — and cleans the hash).
		// The list intent stays a clean "/" — its target sits so near the top that
		// the browser's own #projects jump gets clamped and fights the collapse.
		document.querySelectorAll('a[data-projects-link]').forEach((link) => {
			link.addEventListener('click', (e) => {
				if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
				e.preventDefault();
				const slug = link.dataset.projectSlug;
				if (nav.dataset.home === 'true') {
					history.replaceState(null, '', '/');
					goToProjects(true, slug);
				} else {
					try { sessionStorage.setItem(PROJECTS_FLAG, slug || '1'); } catch (err) {}
					window.location.href = slug ? `/#project-${slug}` : '/';
				}
			});
		});

		// Opening a project from the list records the exact scroll position it was
		// opened from (as "slug:y"), so that project's "Back to projects" restores
		// the very spot the visitor left — not just the card aligned under the nav
		// (see the inline script's `returnY`). Keyed by slug: a detail page reached
		// any other way ignores another card's entry.
		document.querySelectorAll('#project-list a[id^="project-"]').forEach((card) => {
			card.addEventListener('click', () => {
				try {
					sessionStorage.setItem(
						'nav-return',
						`${card.id.slice('project-'.length)}:${Math.round(window.scrollY)}`
					);
				} catch (err) {}
			});
		});

		// ── Home masthead scrub ──
		// q tracks scrollY 1:1 through the collapse range (rAF-throttled like any
		// scroll-linked effect), so the bar collapses and expands exactly as fast
		// as the page scrolls — a wheel notch moves bar, contents and page as one
		// unit with zero added latency. No thresholds, no timed animation.
		if (nav.dataset.home === 'true') {
			// (Cross-page arrivals with a pending projects intent are handled by the
			// inline script above, pre-paint — by the time this module evaluates the
			// page is already resting on the projects view.)
			let ticking = false;
			let settleTimer = 0;
			const apply = () => {
				ticking = false;
				navQ.setQ(navQ.fromScroll());
			};
			// Resting mid-range would leave the bar mid-size; shortly after
			// scrolling pauses, finish the gesture by gliding the SCROLL to the
			// nearest end of the range (never q directly — the bar must stay
			// glued to the page). The settle's own smooth scroll feeds scroll
			// events back through this handler, so q rides it; once it lands,
			// q is 0 or 1 and the settle no-ops. A wheel turn mid-settle
			// interrupts the smooth scroll natively and scrubbing resumes.
			const settle = () => {
				const qNow = navQ.get();
				if (qNow <= 0 || qNow >= 1) return;
				window.scrollTo({
					top: qNow < 0.5 ? 0 : navQ.range,
					behavior: reduceMotion ? 'instant' : 'smooth',
				});
			};
			window.addEventListener(
				'scroll',
				() => {
					if (!ticking) {
						ticking = true;
						requestAnimationFrame(apply);
					}
					window.clearTimeout(settleTimer);
					if (allowSettle) settleTimer = window.setTimeout(settle, 160);
				},
				{ passive: true }
			);
		}
	}

	// ── Sliding contact label ──
	// A single ink pill glides between the contact icons, always sitting under
	// whichever one is hovered or focused, and carrying that icon's label. When
	// moving between icons it slides + resizes; on appearance it wipes in left
	// to right, and on hide it wipes back out right to left (no slide from the
	// corner, no fade) — the same in/out grammar as the nav links' underline.
	const group = document.getElementById('contact-group');
	const pill = group?.querySelector<HTMLElement>('.contact-slider');
	const pillText = pill?.querySelector<HTMLElement>('.contact-slider-text');

	if (group && pill && pillText) {
		const icons = Array.from(group.querySelectorAll<HTMLAnchorElement>('.btn-icon'));

		// Hidden clone of the pill, used to measure the exact width each label
		// needs — including the external-link arrow when shown — so the pill's
		// width can animate to an explicit px value.
		const measurer = pill.cloneNode(true) as HTMLElement;
		measurer.style.cssText =
			'position:absolute;visibility:hidden;top:-9999px;left:0;opacity:1;transform:none;transition:none;width:auto;';
		group.appendChild(measurer);
		const measurerText = measurer.querySelector<HTMLElement>('.contact-slider-text')!;

		let visible = false;
		let resetTimer = 0;
		let swapSeq = 0;
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const labelFor = (icon: HTMLElement) => icon.getAttribute('data-label') ?? '';
		const isExternal = (icon: HTMLElement) => icon.getAttribute('target') === '_blank';

		// Drop any in-flight roll animation and return the text to a clean,
		// visible resting state (used before every direct repositioning).
		const resetText = () => {
			swapSeq++;
			pillText.style.transition = 'none';
			pillText.style.transform = 'none';
			pillText.style.opacity = '1';
		};

		// Position + size the pill under `icon`, showing `text`. Links that open
		// in a new tab also get the trailing ↗ arrow.
		const place = (icon: HTMLElement, text: string) => {
			const gRect = group.getBoundingClientRect();
			const iRect = icon.getBoundingClientRect();
			const centerX = iRect.left - gRect.left + iRect.width / 2;
			const external = isExternal(icon);
			resetText();
			measurerText.textContent = text;
			measurer.classList.toggle('is-external', external);
			pillText.textContent = text;
			pill.classList.toggle('is-external', external);
			pill.style.width = `${measurer.offsetWidth}px`;
			pill.style.transform = `translateX(${centerX}px) translateX(-50%)`;
		};

		// Roll the current text up and out, then roll `text` up into place —
		// used for the copy feedback, so "Copied!" animates in and back without
		// resizing the pill.
		const swapText = (text: string) => {
			if (reduce) {
				pillText.textContent = text;
				return;
			}
			const seq = ++swapSeq;
			pillText.style.transition = 'transform 0.08s ease, opacity 0.08s ease';
			pillText.style.transform = 'translateY(-100%)';
			pillText.style.opacity = '0';
			window.setTimeout(() => {
				if (seq !== swapSeq) return; // superseded
				pillText.textContent = text;
				pillText.style.transition = 'none';
				pillText.style.transform = 'translateY(100%)';
				pillText.style.opacity = '0';
				void pillText.offsetHeight; // reflow so the entry animates
				pillText.style.transition =
					'transform 0.12s cubic-bezier(0.34, 1.35, 0.64, 1), opacity 0.1s ease';
				pillText.style.transform = 'translateY(0)';
				pillText.style.opacity = '1';
			}, 80);
		};

		const showAt = (icon: HTMLElement, text = labelFor(icon)) => {
			if (visible) {
				pill.style.opacity = '1';
				place(icon, text); // slide + resize to the new icon
			} else {
				// Appear with a left-to-right wipe (matching the nav-link
				// underline) rather than a fade: kill transitions, position it
				// fully clipped from the right edge, then release the clip so the
				// label reveals left to right. Reduced motion just snaps it in.
				pill.style.transition = 'none';
				place(icon, text);
				pill.style.opacity = '1';
				pill.style.clipPath = reduce ? 'inset(0 0 0 0)' : 'inset(0 100% 0 0)';
				void pill.offsetWidth; // force reflow so the wipe animates from clipped
				pill.style.transition = '';
				pill.style.clipPath = 'inset(0 0 0 0)';
				visible = true;
			}
		};

		const hide = () => {
			visible = false;
			// Wipe out right-to-left — the entrance wipe played in reverse, the
			// same in/out symmetry as the nav links' underline (which grows from
			// and retracts toward its left edge). Opacity stays 1; the pill is
			// hidden purely by the clip. Reduced motion snaps it away instead.
			if (reduce) {
				pill.style.transition = 'none';
				pill.style.clipPath = 'inset(0 100% 0 0)';
				void pill.offsetWidth;
				pill.style.transition = '';
				return;
			}
			pill.style.clipPath = 'inset(0 100% 0 0)';
		};

		// Show the label only while the cursor is actually over an icon. Slipping
		// into a gap between two icons doesn't hide instantly — a short grace
		// delay lets a sweep to the next icon cancel the hide and keep the pill
		// gliding — but lingering in the gap clears the label.
		let gapHideTimer = 0;
		icons.forEach((icon) => {
			icon.addEventListener('mouseenter', () => {
				window.clearTimeout(gapHideTimer);
				showAt(icon);
			});
			icon.addEventListener('mouseleave', () => {
				window.clearTimeout(gapHideTimer);
				gapHideTimer = window.setTimeout(hide, 90);
			});
		});
		group.addEventListener('mouseleave', () => {
			window.clearTimeout(gapHideTimer);
			hide();
		});
		group.addEventListener('focusin', (e) => {
			const icon = (e.target as HTMLElement).closest<HTMLElement>('.btn-icon');
			if (icon) showAt(icon);
		});
		group.addEventListener('focusout', (e) => {
			if (!group.contains(e.relatedTarget as Node)) hide();
		});

		// Copy-to-clipboard: swap the pill text to feedback, then restore. On
		// success we swap the text only — keeping the rectangle at the "Copy
		// email" width so it doesn't resize. The (rare) fallback hint is longer,
		// so that one does resize to stay readable.
		icons.forEach((icon) => {
			const address = icon.dataset.copy;
			if (!address) return;
			icon.addEventListener('click', async (e) => {
				e.preventDefault();
				let ok = true;
				try {
					await navigator.clipboard.writeText(address);
				} catch {
					ok = false;
				}
				window.clearTimeout(resetTimer);
				if (ok) {
					if (!visible) showAt(icon);
					swapText('Copied!'); // roll in, same width
					resetTimer = window.setTimeout(() => {
						if (visible) swapText(labelFor(icon)); // roll back
					}, 1500);
				} else {
					showAt(icon, 'Press ⌘C to copy'); // longer hint: resize to fit
					resetTimer = window.setTimeout(() => {
						if (visible) place(icon, labelFor(icon));
					}, 1500);
				}
			});
		});
	}

	// ── Sliding nav-link underline (interactivity) ──
	// The inline script above already positioned the underline under the active
	// link (and replayed any cross-page slide). This adds the live behaviour:
	// the underline follows the cursor/focus to whichever link is hovered, and
	// springs back to the active link when the pointer or focus leaves. Moving
	// between the two links slides it across (each link's mouseenter repositions
	// it), matching the contact pills' slide + resize grammar.
	const navLinksEl = document.querySelector<HTMLElement>('#site-nav .nav-links');
	const navUnderline = navLinksEl?.querySelector<HTMLElement>('.nav-underline');
	if (navLinksEl && navUnderline) {
		navLinksEl.classList.add('has-slider'); // defensive: inline script may have been skipped
		const navItems = Array.from(navLinksEl.querySelectorAll<HTMLAnchorElement>('a[data-nav-link]'));
		const activeItem = () =>
			navItems.find((a) => a.getAttribute('aria-current') === 'page') ?? navItems[0];
		const reduceUnderline = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// Slide (or, with animate=false, snap) the underline under `link`. Widths
		// are measured in the container's untransformed layout space, so the
		// numbers are correct whether the nav is expanded or compact.
		const placeUnderline = (link: HTMLElement | undefined, animate: boolean) => {
			if (!link) return;
			// Keep the carried-position record current (mirrors the inline place()).
			navUnderline.dataset.at = link.getAttribute('data-nav-link') ?? '';
			const cs = getComputedStyle(link);
			const padL = parseFloat(cs.paddingLeft) || 0;
			const padR = parseFloat(cs.paddingRight) || 0;
			const x = link.offsetLeft + padL;
			const w = Math.max(0, link.offsetWidth - padL - padR);
			if (!animate) navUnderline.style.transition = 'none';
			navUnderline.style.transform = `translateX(${x}px)`;
			navUnderline.style.width = `${w}px`;
			if (!animate) {
				void navUnderline.offsetWidth;
				navUnderline.style.transition = '';
			}
		};

		const slide = !reduceUnderline;
		navItems.forEach((link) => {
			link.addEventListener('mouseenter', () => placeUnderline(link, slide));
			link.addEventListener('focus', () => placeUnderline(link, slide));
		});
		// Spring back to the active link once hover/focus leaves the group.
		navLinksEl.addEventListener('mouseleave', () => placeUnderline(activeItem(), slide));
		navLinksEl.addEventListener('focusout', (e) => {
			if (!navLinksEl.contains(e.relatedTarget as Node)) placeUnderline(activeItem(), slide);
		});

		// Re-rest the underline (no animation) whenever the links' geometry can
		// shift out from under it: the web font swapping in after first paint, or
		// a viewport resize (including crossing the sm breakpoint where the links
		// appear, and the compact ⇄ expanded change on the home page).
		const restUnderline = () => {
			// Don't yank the underline to the active link mid-arrival-slide (the
			// inline script flags that with data-sliding); let the glide finish.
			if (navUnderline.dataset.sliding === '1') return;
			placeUnderline(activeItem(), false);
		};
		document.fonts?.ready.then(restUnderline);
		let underlineResizeTimer = 0;
		window.addEventListener(
			'resize',
			() => {
				window.clearTimeout(underlineResizeTimer);
				underlineResizeTimer = window.setTimeout(restUnderline, 100);
			},
			{ passive: true }
		);
	}
</script>

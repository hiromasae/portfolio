---
import { contacts } from '../data/projects';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const onHome = path === '/';
---

<nav
	id="site-nav"
	data-home={onHome ? 'true' : 'false'}
	class="sticky top-0 z-40 bg-[var(--paper)]"
>
	{/* The bar has one state. Its type and buttons are authored at full size
	    and scaled down into it — see the nav geometry block in global.css,
	    which also records the expanded masthead this replaced (removed
	    2026-08-02). */}
	<div class="mx-auto max-w-[960px] px-5">
		{/* The bar's bottom hairline is NOT in here — it hangs off #site-nav, out
		    past this 960px shell, so it spans the window the way the bar's paper
		    does (2026-08-03, second pass; it rode inside this shell's padding for
		    a few hours in between). The bar is sticky and opaque, so content
		    scrolls under it all the way to both window edges, and its edge has to
		    be drawn across all of that or the margins read as clipping. The full
		    argument, and why 100vw is the wrong tool for it, is in the two-hairlines
		    block in global.css.

		    It is drawn there as a pseudo-element rather than as a border here
		    because it fades out at both ends and a border can only be one flat
		    colour. The rule over the projects list is its pair — same --rule
		    gradient, one device for indexing the page — and is held to the column,
		    which is the difference between a band's underside and a break inside
		    the text.

		    The vertical padding lives here rather than on the row inside, so the
		    line sits under the padding — at the bar's true bottom edge — instead
		    of tight against the icons. Nothing is positioned on this box any more
		    now that the line has moved off it. */}
		<div class="nav-pad">
		{/* `relative` positions the contact group, which is centred on this box
		    rather than laid out between its neighbours: the wordmark is far wider
		    than the toggle, so in flow the cluster would sit noticeably right of
		    the bar's centre. Out of flow it also can't push the toggle around, so
		    the row's height comes from the two buttons alone. */}
		<div class="nav-inner relative flex items-center">
			{/* Left cluster: the wordmark alone since the Projects/About links came
			    out (2026-08-01). The wrapper still carries the scale-down (see
			    .nav-left in global.css) rather than the <a> itself — it's where a
			    second element beside the name would go back. */}
			<div class="nav-left relative flex origin-left items-center">
				{/* The monogram carries --dye-name rather than --ink — the one piece
				    of type on the site that is a mark rather than reading matter.
				    --dye-name is tuned for DEPTH, not just legibility: it has to
				    out-contrast the rest of the bar or the biggest thing in it reads as
				    the furthest back. Lightening it on the light theme is a hierarchy
				    regression, not a taste call, and the HUE is what makes both possible
				    at once — see the dye block in global.css before recolouring.

				    Note the mark's contrast is also set from OUTSIDE this file: it is a
				    verbatim palette hex, so the only thing that moves it is --paper.
				    That is how the light theme's inversion was resolved on 08-12 —
				    the ground went near-white and the mark walked up past the muted
				    text without being recoloured. Don't try to fix a depth complaint
				    here; it is not reachable from this component.

				    Initials since 2026-08-02 (was the full "Hiro Eernisse"). The
				    accessible name has to say what the mark can't: "HE" alone reads as
				    two letters to a screen reader, and this is the site's home link. */}
				<a
					href="/"
					class="nav-logo text-[2.5rem] font-semibold tracking-tight text-[var(--dye-name)]"
					aria-label="Hiro Eernisse — home"
				>
					HE
				</a>
			</div>

		{/* Centred on the bar itself (2026-08-02). The layout box is wider than
		    what the cluster draws — the buttons are scaled down inside it — but
		    both are centred on the same line, so the drawn icons land on the
		    bar's centre. See the close-ranks block in global.css. */}
		{/* No `gap-*` utility on this box: the gap is --nav-icon-gap in global.css,
		    because the close-ranks translate and the hit-box pseudo are both cut
		    against it and the three have to move together. */}
		<div
			id="contact-group"
			class="absolute left-1/2 top-1/2 flex -translate-x-1/2 -translate-y-1/2 items-center"
		>
			{
				contacts.map((c, i) => {
					const isEmail = c.href.startsWith('mailto:');
					const hoverLabel = isEmail ? 'Copy email' : c.label;
					// --nav-icon-i is markup order, which the load intro's draw stagger
					// marches along; --nav-icon-c is the same position as a signed offset
					// from the cluster's centre, in box-and-gap pitches, which is what the
					// close-ranks translate in global.css needs.
					return (
						<a
							href={c.href}
							class="btn-icon"
							style={`--nav-icon-i: ${i}; --nav-icon-c: ${i - (contacts.length - 1) / 2}`}
							aria-label={hoverLabel}
							data-label={hoverLabel}
							data-copy={isEmail ? c.href.replace('mailto:', '') : undefined}
							target={isEmail ? undefined : '_blank'}
							rel="noopener"
						>
							<Icon name={c.icon} />
						</a>
					);
				})
			}
			{/* One shared label that glides between the icons on hover/focus,
			    naming the hovered one. Positioned entirely by script. Bare text
			    since 2026-08-03 — it wore an ink chip before that.
			    The ↗ shows only for external (new-tab) links.

			    FOUR elements, and every split is load-bearing. Each owns exactly
			    one transform channel, which is the whole reason there are four:
			      .contact-slider      the POSITIONER (its transform is where the pill
			                           is, its transition is the slide between icons)
			      .contact-slider-press the PRESS (2026-08-04). Dips the entire pill —
			                           plate, label and ↗ — while the pointer is down,
			                           so it presses with the button it names. It has
			                           to be its own box: the plate's transform is
			                           owned outright by the pop, whose animations are
			                           `both`-filled and therefore beat an inline
			                           style forever after they finish.
			      .contact-slider-in   the visible plate, and the only thing that
			                           plays the pop. Putting the pop on the positioner
			                           would replay it on every slide, since the slide
			                           moves the same transform property.
			      .contact-slider-stamp the CONTENT, which the copy confirmation
			                           stamps. It is its own box so the stamp scales
			                           the whole row — the label and the ↗ together —
			                           about the plate's centre. Scaling the text span
			                           alone would leave the arrow behind and swing the
			                           word off-centre on external links. (Punching the
			                           plate was the thing this box existed to AVOID
			                           until 2026-08-04; the press does exactly that
			                           now, one box up, which is why the two gestures
			                           no longer share an element.)
			                           (It briefly also held a confirmation tick,
			                           removed 2026-08-03 — the stamp says it.) */}
			<span class="contact-slider" aria-hidden="true">
				<span class="contact-slider-press">
				<span class="contact-slider-in">
					<span class="contact-slider-stamp">
						<span class="contact-slider-text"></span>
						<svg
							class="contact-slider-ext"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="square"
							stroke-linejoin="miter"
							aria-hidden="true"
						>
							<path d="M15 3h6v6" />
							<path d="M10 14 21 3" />
							<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
						</svg>
					</span>
				</span>
				</span>
			</span>
		</div>

		{/* Light/dark toggle: the classic contrast glyph — a circle half ink,
		    half paper, drawn at the contact icons' size and stroke. The filled
		    side marks the current theme (right = light, left = dark); on toggle
		    the ink SWEEPS across to the other side — a slide, not a spin, to
		    match the site's motion language, and always travelling RIGHTWARD:
		    the fill is a pair of rects one pattern-period (18 units) apart
		    sliding inside a static circular clip (animating rects, not the
		    clipPath, keeps the motion working in Safari), so light→dark can
		    wrap — ink exits through the circle's right edge while the twin
		    rect pours in from the left. See the theme-swap block in
		    global.css. `ml-auto` holds it at the bar's right edge — with the
		    contacts centred out of flow it's the only thing left in the row
		    after the wordmark. Its close-ranks translate in global.css assumes
		    the same 2.9rem box as the contacts, which the default .btn-icon
		    padding + 1.9rem glyph give it already. The button is named for the
		    theme a click switches TO (play/pause-style); the script keeps
		    aria-label and the hover pill on the same text.

		    RESTORED 2026-08-06 after one day as a settings gear (a six-tooth
		    lobed cog opening a dropdown of two switches — dark mode and a
		    sticky-bar preference). Hiro's call, on the argument that this
		    glyph ANNOUNCES what it does where a gear announces nothing, which
		    matters here more than most places: Layout.astro deliberately
		    ignores prefers-color-scheme, so every light-mode visitor lands on
		    dark and this button is their only way out. The gear, its flywheel
		    spin and the whole menu are at faf42e8 if a settings surface is
		    ever wanted — with the caveat that two settings didn't earn one.
		    The sticky-bar preference was dropped outright rather than moved:
		    sticky is the design's call to make. */}
		<div id="theme-toggle-wrap" class="relative ml-auto flex self-center">
			{/* The pre-JS name. Dark is the site's default (stamped on <html> in
			    Layout.astro), so the button starts out offering the way OUT of
			    it; the script's syncThemeState corrects this on load for a
			    visitor whose saved choice is light. */}
			<button
				id="theme-toggle"
				type="button"
				class="btn-icon theme-toggle"
				aria-label="Light mode"
			>
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="square"
					aria-hidden="true"
				>
					<defs>
						<clipPath id="theme-fill-clip">
							<circle cx="12" cy="12" r="9" />
						</clipPath>
					</defs>
					{/* --len: measured circumference for the load intro's circle draw —
					    same true-unit dash scheme as the contact icons (Icon.astro). */}
					<circle cx="12" cy="12" r="9" style="--len: 56.25" />
					<g clip-path="url(#theme-fill-clip)">
						<rect class="theme-fill-rect" x="12" y="2" width="9" height="20" fill="currentColor" stroke="none" />
						{/* The twin, exactly one period (18) left: off-circle at rest
						    in light (its right edge only touches the clip's tangent
						    point), it becomes the left-half fill as the sweep carries
						    it in. Both rects share the class so the resting transforms
						    and sweep keyframes drive them in lockstep. */}
						<rect class="theme-fill-rect" x="-6" y="2" width="9" height="20" fill="currentColor" stroke="none" />
					</g>
				</svg>
			</button>
			{/* Twin of the contact pill (same class, so same look and wipes) —
			    deliberately its OWN element rather than the shared slider: the
			    shared pill gliding across the ml-8 gap would visually annex the
			    toggle into the contacts cluster. See the toggle-label block in
			    the script below.
			    It carries the press box too (2026-08-04): the toggle is a button
			    like the other four and its label dips with it. No stamp box —
			    nothing here copies, and the label's own click gesture is the
			    horizontal roll, which lives on the text span and so passes
			    through the press untouched. */}
			<span class="contact-slider" aria-hidden="true">
				<span class="contact-slider-press">
					<span class="contact-slider-in">
						<span class="contact-slider-text"></span>
					</span>
				</span>
			</span>
		</div>
		</div>
		</div>
	</div>
</nav>

<script is:inline>
	// ── Arrival choreography ──
	// Everything that must happen pre-paint:
	//   - the projects-landing intent (position the page before first paint)
	//   - the load intro: the bar's entrance, whose compositor-side keyframes
	//     (global.css) start at 'interactive' — readyState 'interactive' fires
	//     before module scripts evaluate, so the intro can't be starved by the
	//     module chain (in dev, the Vite client) on a slow round trip
	//   - the reveal-* classes the content cascade keys off
	//
	// Until 2026-08-02 it also owned the "q model": the bar's geometry was a
	// progress value tweened between an expanded masthead and the compact bar,
	// triggered by the scroll crossing the top of the home page and handed
	// across MPA navigations through sessionStorage so the two pages' bars
	// joined up. The masthead is gone. All that survives of the handoff is the
	// internal-navigation flag below, which still decides whether the bar
	// introduces itself on arrival.
	(function () {
		var nav = document.getElementById('site-nav');
		if (!nav) return;
		var onHome = nav.dataset.home === 'true';
		var root = document.documentElement;
		var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// Stamp the clock on the way out, so the next page of the site can tell
		// it was reached from inside (see `internal` below).
		window.addEventListener('pagehide', function () {
			try {
				sessionStorage.setItem('nav-from', String(Date.now()));
			} catch (e) {}
		});

		// A pending "show projects" intent — set when a projects link is clicked on
		// another page. The flag holds '1' for the top of the list or a project
		// slug for a specific card. Handled here, not in the module script, so the
		// scroll to the projects view runs at 'interactive' — before any module
		// script, and before first paint in practice — and the page opens already
		// resting on the target instead of visibly jumping to it.
		var projectsIntent = null;
		if (onHome) {
			try {
				projectsIntent = sessionStorage.getItem('nav-projects');
				sessionStorage.removeItem('nav-projects');
			} catch (e) {}
		}
		// An exact return position — recorded (as "slug:y") by the module script
		// when a project card is opened from the list — so "Back to projects"
		// restores the very scroll position the visitor left, not just the card
		// aligned under the nav. Honored only when the intent names the same
		// project the position was recorded for (a detail page reached some other
		// way falls back to the card alignment), and consumed on use so a stale
		// entry can't hijack a later landing.
		//
		// ⚠ 2026-08-10: DORMANT. "Back to projects" was removed, and it was the
		// only thing that ever set an intent — so the guard below is never true
		// and returnY never leaves null. The recorder still writes 'nav-return'
		// on every card click, which means the entry now accumulates and is
		// consumed by nobody. Harmless (one short sessionStorage key, overwritten
		// each click, dies with the tab) and left in place so the feature is one
		// anchor away from working. Full context at the data-projects-link
		// handler in the module script below.
		var returnY = null;
		if (projectsIntent && projectsIntent !== '1') {
			try {
				var ret = sessionStorage.getItem('nav-return');
				if (ret) {
					var retSep = ret.indexOf(':');
					if (ret.slice(0, retSep) === projectsIntent) {
						returnY = Math.max(0, +ret.slice(retSep + 1) || 0);
						sessionStorage.removeItem('nav-return');
					}
				}
			} catch (e) {}
		}
		// Curtain for the landing (see global.css): first paint can beat both the
		// 'interactive' scroll below and the browser's own fragment scroll, which
		// would flash the top of the page for a frame before snapping down to the
		// card. Content stays hidden until positioned; arrive() always lifts it.
		if (projectsIntent) document.documentElement.classList.add('projects-landing');

		// Did we arrive from another page of the site? The age cap means returning
		// to a stale tab (e.g. from an external site much later) reads as a fresh
		// arrival and gets the entrance.
		var internal = false;
		try {
			var stamp = sessionStorage.getItem('nav-from');
			sessionStorage.removeItem('nav-from');
			if (stamp) internal = Date.now() - +stamp < 10000;
		} catch (e) {}

		// ── Load intro: the bar's entrance ──
		// Only for arrivals that AREN'T an internal navigation — clicking through
		// the site shouldn't re-introduce the bar on every page — EXCEPT a reload,
		// which also stamps the clock on its way out (pagehide fires) but should
		// still get the entrance. First visits and external arrivals qualify. A
		// projects landing skips it: that arrival opens mid-list, where an
		// entrance above the target is beside the point. The class goes on
		// pre-paint so first paint holds the bar hidden at the animation's first
		// frame (the holds in global.css); runLoadIntro releases it at
		// 'interactive'.
		//
		// ONCE PER TAB-SESSION — EXCEPT AN EXPLICIT RELOAD (2026-08-06, Hiro,
		// both calls the same day: the gate landed first, then "I should be
		// able to see it on reload"). The full ceremony runs ~2.8s since the
		// hairline finale joined it, and it earns that on a first meeting; but
		// a reload is a deliberate act — "show me again" — and it is also how
		// this site's own author checks the entrance, so it always replays.
		// What the session stamp actually shortens is the one remaining hard
		// arrival: a same-tab return from an external site after the nav-from
		// stamp has gone stale (>10s), where re-greeting someone who left a
		// minute ago would read as the site forgetting them. Those take the
		// internal-navigation form: bar at rest, cascade at once, the projects
		// rule still closing it (its --hold+1240ms delay needs no class). The
		// stamp is written only when the ceremony actually PLAYS — a visitor
		// whose first arrival is a projects landing (which skips the intro)
		// still gets the full entrance on their first plain load.
		// sessionStorage, like nav-from/nav-return: per tab, dies with it.
		// ("Every arrival" was the 2026-08-02 call; it was made when the whole
		// intro ran ~1.35s.)
		var navType = '';
		try {
			var navEntry = performance.getEntriesByType('navigation')[0];
			if (navEntry) navType = navEntry.type;
		} catch (e) {}
		var introSeen = false;
		try {
			introSeen = !!sessionStorage.getItem('nav-introed');
		} catch (e) {}
		var hardArrival = !projectsIntent && (!internal || navType === 'reload');
		var loadIntro = !reduce && hardArrival && (!introSeen || navType === 'reload');
		// The short form: a repeat hard arrival — no bar entrance, but still a
		// hard load, with everything that implies for the webfonts (see the
		// reveal-wait note below).
		var shortForm = !reduce && !loadIntro && hardArrival;
		if (loadIntro) {
			root.classList.add('nav-intro-draw');
			try {
				sessionStorage.setItem('nav-introed', '1');
			} catch (e) {}
		}

		// ── Content reveal coordination ──
		// The pages' .reveal cascades (global.css) start after whatever entrance
		// the bar is playing, keyed off classes captured here — pre-paint, where
		// this load's arrival shape is decided. PERSISTENT classes on purpose, not
		// the nav-intro-draw one: that is removed at cleanup, and an
		// animation-delay that changes mid-flight restarts the animation.
		//   reveal-hold-land: a landing on the TOP of the list, where the first
		//     card sits under the bar exactly as on a fresh home load, so the
		//     cascade plays; a short beat first clears the 'interactive' landing
		//     scroll.
		//   reveal-skip: a landing resting on a specific card mid-list (Back to
		//     projects) — content reveals at rest.
		//   reveal-hold-draw: a load intro is coming — overlap its choreography.
		// An ordinary internal navigation takes none of them: the bar is already
		// there, so the cascade plays at once.
		if (projectsIntent === '1') root.classList.add('reveal-hold-land');
		else if (projectsIntent) root.classList.add('reveal-skip');
		else if (loadIntro) {
			root.classList.add('reveal-hold-draw');
			// The bar and the content enter as one choreography, so they wait on
			// the type as one too — see whenTypeSettled below. The cascade is
			// PAUSED (rule in Layout.astro's critical block) rather than given a
			// bigger --hold: the hold is tuned against the intro's fixed delays, so
			// pausing shifts the whole sequence intact, where rewriting
			// animation-delay mid-flight would restart it.
			root.classList.add('reveal-wait');
		} else if (shortForm) {
			// The short form is still a HARD load — and a hard reload bypasses
			// the font cache — so the type problem the ceremony waits out (the
			// whenTypeSettled note below) hits the cascade here too: content
			// slid in wearing the fallback face and snapped to Recursive when
			// it landed (Hiro, 2026-08-06, the day after the session gate made
			// this path reachable by reload). Same cure, same insurance: pause
			// until type settles; a warm cache resolves fonts.ready in the
			// same tick and costs the common repeat nothing.
			root.classList.add('reveal-wait');
		}

		if (!projectsIntent && !loadIntro && !shortForm) return;

		// Land on the projects view: the exact remembered position when we have
		// one, otherwise the intended card (or the top of the list) ~12px under
		// the bar (a one-shot copy of goToProjects in the module script below —
		// keep the two in step). For a card, the browser's native fragment scroll
		// has already positioned the page pre-paint (the link navigates to
		// /#project-<slug>); this settles the final position and drops the hash
		// off the URL. 'instant' overrides the stylesheet's `scroll-behavior:
		// smooth`; a landing must not glide.
		var landOnProjects = function () {
			if (returnY !== null) {
				window.scrollTo({ top: returnY, behavior: 'instant' });
			} else {
				var el =
					(projectsIntent !== '1' && document.getElementById('project-' + projectsIntent)) ||
					document.getElementById('project-list');
				if (el) {
					var y = el.getBoundingClientRect().top + window.scrollY - nav.offsetHeight - 12;
					window.scrollTo({ top: Math.max(y, 0), behavior: 'instant' });
				}
			}
			if (location.hash) history.replaceState(null, '', '/');
		};

		// Don't start the entrance on type that's about to change under it.
		// The wordmark wipes by clipping a PERCENTAGE of its own box, so a
		// webfont swap mid-wipe re-resolves the clip against a new box AND
		// re-sets the glyphs inside it, in one frame. Measured 07-29 (dev, warm):
		// Satoshi landed ~250ms into the draw and snapped the wordmark 435px →
		// 348px, throwing the reveal edge ~83px backwards mid-motion. Only the
		// left of the bar moves — the icons are SVG, immune to font metrics —
		// which is exactly how it reads. Frame pacing was clean throughout
		// (16.7ms median, no gap over 25ms), so this is a layout jump and not
		// jank: nothing about how the animation is driven can fix it, only what
		// it runs on top of.
		//
		// Waiting costs nothing visible — the bar is held hidden pre-paint until
		// 'go' either way, so this just lands the entrance a beat later on type
		// that then holds still. The race is the insurance: a slow, blocked or
		// offline CDN must not swallow the entrance, so at 1200ms it plays over
		// the fallback exactly as it does today.
		//
		// fonts.load(), NOT fonts.ready alone (2026-08-06). ready resolves
		// when nothing is *currently* loading — and at 'interactive' the woff2
		// request usually hasn't STARTED, because a face only begins loading at
		// first layout of text that uses it. So on a cold cache ready resolved
		// on an empty set, the choreography played on the fallback face, and
		// Recursive snapped every box when it landed mid- or post-flight
		// (Hiro's report; the 07-29 note here previously claimed fonts were
		// "already pending by here", which a warm dev cache made true enough to
		// ship). load() forces the request NOW and resolves when the face is
		// usable; the ready chase behind it catches any other face. The
		// descriptor names the body's own face and floor weight — keep it in
		// step with --font-sans and the weight scale in global.css.
		var whenTypeSettled = function (run) {
			var fired = false;
			var once = function () {
				if (fired) return;
				fired = true;
				run();
			};
			window.setTimeout(once, 1200);
			try {
				document.fonts
					.load('300 1rem "Recursive"')
					.then(function () {
						return document.fonts.ready;
					})
					.then(once, once);
			} catch (e) {
				once();
			}
		};

		// Release the intro's animations (the class was added pre-paint above;
		// global.css holds everything at first-frame until .nav-intro-go).
		// Cleanup is a plain timer just past the last fixed CSS delay+duration —
		// every 'to' frame equals rest, so removing the classes mid-forwards-fill
		// is invisible. A scroll during the intro is fine: the wipe and draws ride
		// clip-path and dash channels, which nothing else on the bar touches.
		var runLoadIntro = function () {
			whenTypeSettled(function () {
				// Both clocks start in the same frame, which is the point of the
				// pause — the cascade's hold is measured from the intro's start.
				root.classList.add('nav-intro-go');
				root.classList.remove('reveal-wait');
				window.setTimeout(function () {
					root.classList.remove('nav-intro-draw', 'nav-intro-go');
				}, 2450);
			});
		};

		// 'interactive' means main and the cards exist and layout is measurable;
		// it fires before module scripts evaluate.
		var arrive = function () {
			if (projectsIntent) {
				try {
					landOnProjects();
				} finally {
					root.classList.remove('projects-landing');
				}
			}
			if (loadIntro) runLoadIntro();
			else if (shortForm)
				whenTypeSettled(function () {
					root.classList.remove('reveal-wait');
				});
		};
		if (document.readyState !== 'loading') {
			arrive();
		} else {
			document.addEventListener('readystatechange', function onReady() {
				document.removeEventListener('readystatechange', onReady);
				arrive();
			});
		}
	})();
</script>

<script>
	// ── Theme toggle ──
	// Flip <html data-theme> and remember the manual choice. The initial theme
	// is resolved pre-paint in Layout.astro; this only handles user clicks.
	//
	// A gear-run settings menu stood here for a day (08-05 → 08-06) with this
	// control as one of two switch rows inside it. It went back to a bare
	// toggle because the theme is the one setting visitors actually reach for
	// and a dropdown made it two clicks behind an icon that names nothing —
	// see the glyph's block in the markup above. The menu's script (disclosure
	// + outside-click/Escape dismissal + the gear's flywheel spin) is at
	// faf42e8.
	const themeToggle = document.getElementById('theme-toggle');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	// The button is named for the theme a click switches TO (play/pause-style):
	// "Dark mode" while light is active, "Light mode" while dark is. The hover
	// pill below shows the same text, so the visible label and the accessible
	// name always agree. The glyph's resting position comes from CSS state
	// alone; only the name needs syncing.
	// "mode", not "theme" (07-31, Hiro): the pill is read as an instruction by
	// a visitor who has just moved the cursor onto a half-filled circle, and
	// "light mode" is what that control is called everywhere else.
	const themeLabel = () =>
		document.documentElement.dataset.theme === 'dark' ? 'Light mode' : 'Dark mode';
	// Everything downstream of data-theme that isn't CSS. The favicon rides
	// along here rather than in the click handler so it stays correct on a
	// bfcache restore or any other path that re-runs this script with a theme
	// already saved — the same reason the aria-label is synced and not set once.
	const syncThemeState = () => {
		themeToggle?.setAttribute('aria-label', themeLabel());
		window.__syncFavicon?.(document.documentElement.dataset.theme);
	};
	syncThemeState();
	themeToggle?.addEventListener('click', () => {
		const root = document.documentElement;
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		// Suppress every transition for the frame the theme flips so the whole
		// page changes at once — no element animates on its own clock, and grey
		// text never dips through a low-contrast mid-tone. Force a style flush
		// with transitions off, then re-enable them on the next frame.
		root.classList.add('theme-switching');
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch (e) {}
		syncThemeState();
		// Play the ink sweep. It's a keyframe animation (unaffected by the
		// transition suppression above), retriggered by removing the class and
		// forcing a reflow before re-adding so rapid clicks restart it cleanly.
		if (themeToggle && !prefersReducedMotion.matches) {
			themeToggle.classList.remove('theme-anim');
			void themeToggle.offsetWidth;
			themeToggle.classList.add('theme-anim');
		}
		void root.offsetHeight;
		requestAnimationFrame(() => root.classList.remove('theme-switching'));
	});

	const nav = document.getElementById('site-nav');
	if (nav) {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// ── "Projects" → projects section ──
		// The projects list is the top of the home page, sitting directly under
		// the bar. A plain #projects anchor lands the first card under the sticky
		// bar; instead we scroll to the spot where it sits just beneath it.
		// Cross-page, a sessionStorage flag carries the intent so the home page
		// lands there directly (see the inline script's `projectsIntent`).
		const PROJECTS_FLAG = 'nav-projects';

		// The y that rests `el` ~12px under the bar (mirrored by the inline
		// script's `landOnProjects` — keep the two in step).
		const compactTargetY = (el) => {
			const top = el.getBoundingClientRect().top + window.scrollY - nav.offsetHeight;
			return Math.max(top - 12, 0);
		};

		// Scroll to the projects view — a specific card when `slug` names one
		// (Back-to-projects returns you to the card you came from), otherwise the
		// top of the list.
		const goToProjects = (smooth, slug) => {
			const target =
				(slug && document.getElementById(`project-${slug}`)) ||
				document.getElementById('project-list');
			if (!target) return;
			// 'instant', not 'auto': the stylesheet's `scroll-behavior: smooth`
			// turns 'auto' into a glide, and the landing snap must not animate.
			window.scrollTo({
				top: compactTargetY(target),
				behavior: smooth && !reduceMotion ? 'smooth' : 'instant',
			});
		};

		// Intercept every projects link (nav "Projects", "Back to projects"). On
		// home we scroll in place. From elsewhere we stash the intent — '1' for the
		// top of the list, or a slug for a specific card — and navigate. A slug
		// intent keeps the card's #fragment on the URL: the browser's native
		// fragment scroll positions the page *during parsing*, before first paint,
		// so the landing opens on the card with no visible jump (the inline
		// script's landOnProjects then settles the exact position — a remembered
		// return spot when one exists — and cleans the hash).
		// The list intent stays a clean "/" — its target sits so near the top that
		// the browser's own #projects jump gets clamped and fights the collapse.
		//
		// ⚠ 2026-08-10: THIS SELECTOR MATCHES NOTHING. The comment above says
		// "every projects link (nav 'Projects', 'Back to projects')" and both are
		// now gone — the nav's went on 08-01, and Hiro removed the project pages'
		// back button today. This handler is the ONLY writer of PROJECTS_FLAG, so
		// with no element to bind to, `projectsIntent` in the inline script is
		// permanently null and everything it gates is unreachable: the
		// .projects-landing hold, landOnProjects(), reveal-hold-land,
		// reveal-skip, the returnY restore, and goToProjects() itself (this is
		// its only caller). The card-click recorder below still writes
		// 'nav-return' faithfully; nothing reads it any more.
		//
		// Deliberately NOT deleted. The machinery is correct and was expensive to
		// get right — it is one `data-projects-link` on one anchor away from
		// working again, and that is a far better state to leave it in than
		// half-unpicked. If it is being retired for good, the removal is this
		// block, goToProjects, compactTargetY, PROJECTS_FLAG, the card recorder,
		// and the whole projectsIntent branch of the inline script — as one
		// change, not piecemeal. See the footer note in pages/projects/[slug].astro.
		//
		// The "More projects" strip added to the project pages later the same day
		// did NOT revive this: its cards are ProjectCards linking straight to
		// /projects/<slug>, so none of them carries the attribute. It did give the
		// recorder below a second page to fire on — see its note.
		document.querySelectorAll('a[data-projects-link]').forEach((link) => {
			link.addEventListener('click', (e) => {
				if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
				e.preventDefault();
				const slug = link.dataset.projectSlug;
				if (nav.dataset.home === 'true') {
					history.replaceState(null, '', '/');
					goToProjects(true, slug);
				} else {
					try { sessionStorage.setItem(PROJECTS_FLAG, slug || '1'); } catch (err) {}
					window.location.href = slug ? `/#project-${slug}` : '/';
				}
			});
		});

		// ── Wordmark → top of the page ──
		// On home the wordmark's href="/" points at the page we're already on, so
		// letting it navigate reloads the projects list to show it again. The
		// visitor asked for the top of the list they're already reading, not a
		// fresh arrival — so scroll there in place. Off home the link navigates
		// normally (that IS a fresh arrival).
		const logo = nav.querySelector<HTMLAnchorElement>('.nav-logo');
		logo?.addEventListener('click', (e) => {
			if (nav.dataset.home !== 'true') return;
			if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
			e.preventDefault();
			// Drop any card fragment left on the URL, same as the Projects link.
			if (location.hash) history.replaceState(null, '', '/');
			// 'instant' overrides the stylesheet's `scroll-behavior: smooth`.
			window.scrollTo({ top: 0, behavior: reduceMotion ? 'instant' : 'smooth' });
		});

		// Opening a project from the list records the exact scroll position it was
		// opened from (as "slug:y"), so that project's "Back to projects" restores
		// the very spot the visitor left — not just the card aligned under the nav
		// (see the inline script's `returnY`). Keyed by slug: a detail page reached
		// any other way ignores another card's entry.
		//
		// ⚠ 2026-08-10: NOT JUST THE HOME PAGE ANY MORE. The project pages grew a
		// "More projects" strip built on the same grid, so `#project-list` — and
		// therefore this selector — now matches on two routes. Nothing breaks:
		// `returnY` is only read when `projectsIntent` is set, and nothing has set
		// that since the back button went, so this is write-only either way. But
		// it is a behaviour change waiting to surface if the pipeline is ever
		// revived, because a strip click records THIS page's scrollY under the
		// TARGET project's slug — a Y measured on a page you'd never be restoring
		// to. Scope this to the home page (or key the entry by origin as well as
		// slug) before switching any of it back on.
		document.querySelectorAll('#project-list a[id^="project-"]').forEach((card) => {
			card.addEventListener('click', () => {
				try {
					sessionStorage.setItem(
						'nav-return',
						`${card.id.slice('project-'.length)}:${Math.round(window.scrollY)}`
					);
				} catch (err) {}
			});
		});
	}

	// ── Sliding contact label ──
	// A single label glides between the contact icons, always sitting under
	// whichever one is hovered or focused, and naming it. (Still called the pill
	// throughout: it wore an ink chip until 2026-08-03.) When
	// moving between icons it slides + resizes — the one motion this pill has.
	// Appearing and disappearing are the POP (2026-08-02, Hiro's pick from a
	// twenty-variant exploration): it springs open from 80% and leaves by
	// shrinking. Those live entirely in CSS, driven by the is-in / is-out
	// classes set below — see the pop block in global.css. Everything between
	// showAt and hide (placement, measurement, the copy-feedback roll) is
	// independent of which gesture is in force.
	const group = document.getElementById('contact-group');
	const pill = group?.querySelector<HTMLElement>('.contact-slider');
	const pillText = pill?.querySelector<HTMLElement>('.contact-slider-text');
	const pillStamp = pill?.querySelector<HTMLElement>('.contact-slider-stamp');
	const pillPress = pill?.querySelector<HTMLElement>('.contact-slider-press');

	if (group && pill && pillText && pillStamp && pillPress) {
		const icons = Array.from(group.querySelectorAll<HTMLAnchorElement>('.btn-icon'));

		// Hidden clone of the pill, used to measure the exact width each label
		// needs — including the external-link arrow when shown — so the pill's
		// width can animate to an explicit px value. Both boxes have to be freed
		// to shrink-wrap: the outer one is width-driven by script, and the inner
		// one is width: 100% of it, which would resolve to nothing here.
		const measurer = pill.cloneNode(true) as HTMLElement;
		measurer.style.cssText =
			'position:absolute;visibility:hidden;top:-9999px;left:0;transform:none;transition:none;width:auto;';
		const measurerIn = measurer.querySelector<HTMLElement>('.contact-slider-in')!;
		measurerIn.style.cssText = 'width:auto;opacity:1;animation:none;';
		group.appendChild(measurer);
		const measurerText = measurer.querySelector<HTMLElement>('.contact-slider-text')!;

		let visible = false;
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const labelFor = (icon: HTMLElement) => icon.getAttribute('data-label') ?? '';
		const isExternal = (icon: HTMLElement) => icon.getAttribute('target') === '_blank';

		// Drop any in-flight stamp and return the label to a clean, visible resting
		// state (used before every direct repositioning).
		const resetText = () => {
			pillStamp.style.transition = 'none';
			pillStamp.style.transform = 'none';
			pillStamp.style.opacity = '1';
		};

		// Position + size the pill under `icon`, showing `text`. Links that open
		// in a new tab also get the trailing ↗ arrow.
		const place = (icon: HTMLElement, text: string) => {
			const gRect = group.getBoundingClientRect();
			const iRect = icon.getBoundingClientRect();
			const centerX = iRect.left - gRect.left + iRect.width / 2;
			const external = isExternal(icon);
			resetText();
			measurerText.textContent = text;
			measurer.classList.toggle('is-external', external);
			pillText.textContent = text;
			pill.classList.toggle('is-external', external);
			pill.style.width = `${measurer.offsetWidth}px`;
			pill.style.transform = `translateX(${centerX}px) translateX(-50%)`;
		};

		// ── The copy confirmation: the pill rides the button's press ──
		// 2026-08-03. The gesture began as Hiro's pick from a fourteen-variant
		// exploration (roll, odometer both ways, crossfade, pop, wipe, letters,
		// flip, defocus, stamp, tick, plate flash, colour sweep, countdown) — the
		// STAMP, which dropped the label in from 135% on a hard 1.6 overshoot.
		//
		// It came out because it could not be synchronised with the icon, and the
		// reason is worth keeping: a stamp lands by SHRINKING (1.35 → 1) while the
		// pressed glyph releases by GROWING (0.9 → 1). Aligning the start frame
		// and the duration did nothing, because the two were mirror images —
		// maximally opposed at exactly the moment both springs overshoot. Same
		// clock, opposite motion, and it read as two things happening at once.
		//
		// So the pill now does what the icon does, on the same events and the same
		// pair of tokens: it dips on pointerdown over --dur-press, and springs
		// back to 1 over --dur-pop-in on --ease-pop when the press is let go — the
		// label changing at the turn. One object with two parts, which is what the
		// button and its own name should have been all along.
		//
		// ── 2026-08-04: the dip moved out to the whole pill ──
		// Hiro: "the whole pill and the text within". It was scaling the CONTENT
		// box, so the words shrank inside a plate that sat perfectly still — which
		// is the one thing a chip cannot do while the button under it is being
		// pressed. It now runs on .contact-slider-press, one box further out, and
		// takes the plate with it. Two consequences worth knowing:
		//   · the depth is --pill-press (0.94), NOT the glyph's 0.9 — see the token
		//     for why a bigger box needs a smaller ratio to travel the same amount;
		//   · the copy confirmation no longer dips at all. It used to share this
		//     element, and two nested 0.9s multiply to 0.81 — the word would punch
		//     twice as deep as the plate carrying it. The swap is an opacity blink
		//     now and the plate supplies every bit of the motion.
		//
		// The earlier roll (out right, in from the left) is also worth not
		// rediscovering: horizontal is the axis this pill already owns, since its
		// identity is SLIDING SIDEWAYS between the four icons. A text roll on that
		// axis inside a box that travels on it is two messages in one channel.
		// Scale is free precisely because nothing else here uses it.

		// The dip. Every contact icon gets it, not just the one that copies: the
		// pill hangs under whichever icon is hovered and the press belongs to the
		// BUTTON, so a pill that sat still under three of the four would be the
		// same mismatch this block exists to fix.
		const pressPill = () => {
			if (reduce) return;
			pillPress.style.transition = `transform var(--dur-press) var(--ease-pop)`;
			pillPress.style.transform = 'scale(var(--pill-press))';
		};

		// The release. Mirrors `#site-nav .btn-icon:hover > svg` exactly — on
		// mouseup :active drops, the pointer is still hovering, and the glyph
		// returns to its lift on --dur-pop-in / --ease-pop. Same numbers here, so
		// the two finish on the same frame.
		const releasePill = () => {
			if (reduce) return;
			pillPress.style.transition = `transform var(--dur-pop-in) var(--ease-pop)`;
			pillPress.style.transform = 'scale(1)';
		};

		// Blink only, never a scale: the plate's press is already supplying the
		// motion for the one event that calls this, and a second scale here would
		// compound with it. (It took a `dip` flag for a few hours on 2026-08-04,
		// back when a 1.5s timer also stamped the label back unpressed. The
		// confirmation holds until unhover now, so that caller is gone and the
		// flag with it.)
		const stampText = (text: string) => {
			// The width is deliberately NOT re-measured: the pill stays at the
			// resting label's width so the plate never resizes under the swap.
			// "Copied!" is the shorter word, so it simply sits centred in a
			// rectangle cut for "Copy email" — which is why the gesture scales the
			// content box (whose centre is the plate's) and not the text span.
			pillText.textContent = text;
			if (reduce) return;
			// Blink the ink out and back. The word changes at the turn of the
			// plate's press, which is the moment that wants marking, and the plate
			// is already doing the moving. --dur-press means the word is fully
			// there in the time the glyph takes to dip, so the swap reads as
			// instant.
			pillStamp.style.transition = 'none';
			pillStamp.style.opacity = '0';
			void pillStamp.offsetHeight; // reflow, so the rebound animates
			pillStamp.style.transition = `opacity var(--dur-press) ease`;
			pillStamp.style.opacity = '1';
		};

		const showAt = (icon: HTMLElement, text = labelFor(icon)) => {
			if (visible) {
				place(icon, text); // already up: this is the slide, no entrance replay
				return;
			}
			// Land in position with the slide suppressed — the pill still carries
			// the transform and width it was hidden at, so leaving the transition
			// live would glide it in from the last icon hovered.
			pill.style.transition = 'none';
			place(icon, text);
			void pill.offsetWidth; // reflow, so the restored transition can't see this frame
			pill.style.transition = '';
			// Re-trigger the pop from its first frame. Removing is-in and forcing a
			// reflow before re-adding matters when the exit is still in flight: the
			// class is already gone in that case, but the animation is not, and
			// without the reflow the browser can coalesce the two and play nothing.
			pill.classList.remove('is-out', 'is-in');
			void pill.offsetWidth;
			pill.classList.add('is-in');
			visible = true;
		};

		const hide = () => {
			if (!visible) return;
			visible = false;
			// Hand over to the exit animation, which is `both`-filled and so holds
			// the pill hidden at its end frame — nothing to clean up on a timer.
			pill.classList.remove('is-in');
			pill.classList.add('is-out');
		};

		// Show the label only while the cursor is actually over an icon.
		//
		// The hide is DEFERRED BY A TICK, not by a delay. Leaving one icon for
		// the next fires mouseleave and mouseenter from the same pointer move, so
		// a zero timeout is always cancelled before it can run — which is what
		// keeps an icon-to-icon move a slide instead of an exit followed by a
		// fresh entrance. Any real leave hides on the very next tick, in step with
		// the glyph dropping back.
		//
		// This used to be a 90ms grace, which existed to bridge the dead sliver
		// BETWEEN the icons. The hit boxes tile edge to edge now (see the
		// .btn-icon::after block in global.css) so there is no sliver left to
		// bridge, and the 90ms had become a head start the icon's drop got over
		// the label's — 2026-08-02, Hiro: the two read as disjointed. Restoring a
		// delay here re-opens that gap; widen the hit boxes instead.
		let gapHideTimer = 0;
		icons.forEach((icon) => {
			// The press. Its release is bound to the WINDOW, not to the icon: a
			// press dragged off the button never fires pointerup on it, and the pill
			// must not be left stuck at 0.9. The glyph has the same problem and CSS
			// solves it for free — :active drops wherever the pointer ends up — so
			// this is just what it costs to keep a script-driven element honest
			// beside a state-driven one.
			// On a real click, pointerup's release and the click handler's stampText
			// both run before the next paint, so the extra assignment is invisible
			// rather than a competing animation.
			icon.addEventListener('pointerdown', () => {
				pressPill();
				const release = () => {
					window.removeEventListener('pointerup', release);
					window.removeEventListener('pointercancel', release);
					releasePill();
				};
				window.addEventListener('pointerup', release);
				window.addEventListener('pointercancel', release);
			});
			icon.addEventListener('mouseenter', () => {
				window.clearTimeout(gapHideTimer);
				showAt(icon);
			});
			icon.addEventListener('mouseleave', () => {
				window.clearTimeout(gapHideTimer);
				gapHideTimer = window.setTimeout(hide, 0);
			});
		});
		group.addEventListener('mouseleave', () => {
			window.clearTimeout(gapHideTimer);
			hide();
		});
		group.addEventListener('focusin', (e) => {
			const icon = (e.target as HTMLElement).closest<HTMLElement>('.btn-icon');
			if (icon) showAt(icon);
		});
		group.addEventListener('focusout', (e) => {
			if (!group.contains(e.relatedTarget as Node)) hide();
		});

		// Copy-to-clipboard: stamp the confirmation into the pill. The (rare)
		// fallback hint is much longer than either label, so that one goes through
		// place() and does resize, since a clipped instruction is worse than a
		// moving box.
		//
		// ── The confirmation holds until you leave the icon ──
		// 2026-08-04, Hiro: "Copied!" used to time out after 1.5s and stamp the
		// label back under a pointer that had never moved — the pill answering a
		// question nobody had re-asked, and worse, undoing its own confirmation
		// while you were still looking at it. It now stays for exactly as long as
		// the hover that earned it.
		//
		// There is no revert code, and that is the point: hovering AWAY is what
		// resets it, and every path back into the pill already goes through
		// place(), which rewrites the label and the width from the icon it is
		// landing under. So the slide to a neighbour, the return after an exit and
		// a fresh focus all clear "Copied!" on their own. The same now holds for
		// the ⌘C hint, which had the same timer and wants the persistence even
		// more — it is an instruction, and one that vanishes while you are
		// reaching for the key is the one kind of hint worth nothing.
		//
		// ── The stamp fires BEFORE the write, not after it ──
		// 2026-08-03, Hiro: the stamp has to run with the button's press. It could
		// not, while it was sequenced after `await navigator.clipboard.writeText`.
		// The glyph's press gesture is pure CSS :active, so it releases on mouseup
		// — the same tick as `click` — while an awaited stamp could only start on
		// a later microtask, once the clipboard promise had settled. Two halves of
		// one gesture on two different clocks, and the icon always won.
		//
		// So the feedback is OPTIMISTIC: claim it, then do it, and correct the
		// claim if the write rejects. Safe here because a clipboard rejection is a
		// permission refusal, which comes back immediately rather than late — the
		// correction lands within a frame or two, and it still tells the truth.
		icons.forEach((icon) => {
			const address = icon.dataset.copy;
			if (!address) return;
			icon.addEventListener('click', (e) => {
				e.preventDefault();

				// Synchronous, so this frame is the one the press releases on.
				if (!visible) showAt(icon);
				stampText('Copied!');

				// Wrapped rather than called bare: on an insecure origin
				// navigator.clipboard is undefined, which throws SYNCHRONOUSLY and
				// would escape a .catch() hung off the call itself. The old
				// try/await/catch covered that for free; this is what replaces it.
				Promise.resolve()
					.then(() => navigator.clipboard.writeText(address))
					.catch(() => {
						showAt(icon, 'Press ⌘C to copy'); // longer hint: resize to fit
					});
			});
		});
	}

	// ── Theme toggle label ──
	// A twin of the contact pill: same class (so same look, entrance wipe and
	// exit wipe) under its own button. A lone button needs none of the shared
	// slider's slide-between machinery — the pill just wipes in showing the
	// theme a click would switch TO, and a click rolls the text to the next
	// label (the same roll as the email icon's "Copied!", doubling as
	// confirmation). Kept separate from the shared slider on purpose: one pill
	// gliding across the ml-8 gap would read as the toggle joining the
	// contacts cluster.
	const toggleWrap = document.getElementById('theme-toggle-wrap');
	const togglePill = toggleWrap?.querySelector<HTMLElement>('.contact-slider');
	const togglePillText = togglePill?.querySelector<HTMLElement>('.contact-slider-text');
	const togglePillPress = togglePill?.querySelector<HTMLElement>('.contact-slider-press');
	if (toggleWrap && themeToggle && togglePill && togglePillText && togglePillPress) {
		const reduceToggle = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// Hidden clone for width measurement (mirrors the contact slider's, inner
		// box and all): the pill's width transition needs explicit px, and the
		// two labels differ slightly in width.
		const measurer = togglePill.cloneNode(true) as HTMLElement;
		measurer.style.cssText =
			'position:absolute;visibility:hidden;top:-9999px;left:0;transform:none;transition:none;width:auto;';
		measurer.querySelector<HTMLElement>('.contact-slider-in')!.style.cssText =
			'width:auto;opacity:1;animation:none;';
		toggleWrap.appendChild(measurer);
		const measurerText = measurer.querySelector<HTMLElement>('.contact-slider-text')!;
		const widthFor = (text: string) => {
			measurerText.textContent = text;
			return measurer.offsetWidth;
		};

		let shown = false;
		let rollSeq = 0;

		// Rect-based centering rather than pure CSS: the button's visual box
		// rides the close-ranks transform, and rects see transforms — so the
		// pill lands under the glyph rather than under its full-size layout box
		// (mirrors place()). The center is CLAMPED to keep the pill inside the
		// scrollport: the bar right-anchors the toggle so near the viewport edge
		// that a centered pill would cross clientWidth — and scrollbar-gutter:
		// stable ends painting there, silently shearing the pill's right side.
		const placePill = (text: string) => {
			const wRect = toggleWrap.getBoundingClientRect();
			const bRect = themeToggle.getBoundingClientRect();
			const width = widthFor(text);
			const maxCenter =
				document.documentElement.clientWidth - 8 - width / 2 - wRect.left;
			const centerX = Math.min(
				bRect.left - wRect.left + bRect.width / 2,
				maxCenter
			);
			// Cancel any roll in flight and drop its class: this is the
			// reset-to-a-clean-resting-label path, and a stale .is-rolling would
			// leave the next retrigger with nothing to remove.
			rollSeq++;
			togglePill.classList.remove('is-rolling');
			togglePillText.style.transition = 'none';
			togglePillText.style.transform = 'none';
			togglePillText.style.opacity = '1';
			togglePillText.textContent = text;
			togglePill.style.width = `${width}px`;
			togglePill.style.transform = `translateX(${centerX}px) translateX(-50%)`;
		};

		const showPill = () => {
			if (shown) return;
			// Same pop as the contact pill — the two must appear the same way or
			// the toggle reads as a different kind of control.
			togglePill.style.transition = 'none';
			placePill(themeLabel());
			void togglePill.offsetWidth;
			togglePill.style.transition = '';
			togglePill.classList.remove('is-out', 'is-in');
			void togglePill.offsetWidth;
			togglePill.classList.add('is-in');
			shown = true;
		};

		const hidePill = () => {
			if (!shown) return;
			shown = false;
			togglePill.classList.remove('is-in');
			togglePill.classList.add('is-out');
		};

		// On the BUTTON, not the wrapper (2026-08-03). The wrapper's box is the
		// button's FULL-SIZE 2.9rem layout box, but the button is drawn at
		// --nav-icon-scale and translated toward the container's right edge — so
		// the wrapper reaches ~16px further left than the glyph does, and hovering
		// that strip used to pop the label while the glyph itself stayed at rest.
		// Harmless when the contacts' hit pseudo gave the toggle spill of its own;
		// plainly wrong now that its region is exactly the drawn button (see the
		// hit-box block in global.css). The pill is pointer-events: none, so it
		// can't take the hover away from the button it hangs under.
		themeToggle.addEventListener('mouseenter', showPill);
		themeToggle.addEventListener('mouseleave', hidePill);
		themeToggle.addEventListener('focus', showPill);
		themeToggle.addEventListener('blur', hidePill);

		// ── The press ──
		// 2026-08-04, the same gesture the contact pills got, on the same tokens:
		// the toggle is a button like the other four and its label has no business
		// standing still while it is pushed. Duplicated rather than shared because
		// this pill is deliberately a separate element with its own script block
		// (see the note above) — the twelve lines are the price of that split.
		//
		// The release binds to the WINDOW for the reason the contacts' does: a
		// press dragged off the button never fires pointerup on it, and a
		// script-driven element has no :active to bail it out.
		//
		// Note this rides alongside the click roll rather than fighting it: the
		// roll translates the TEXT SPAN horizontally, two boxes in, so the plate
		// can scale underneath it without either gesture touching the other's
		// transform. That separation is why the label can change identity and be
		// pressed at the same instant, which is exactly what a click does here.
		themeToggle.addEventListener('pointerdown', () => {
			if (reduceToggle) return;
			togglePillPress.style.transition = `transform var(--dur-press) var(--ease-pop)`;
			togglePillPress.style.transform = 'scale(var(--pill-press))';
			const release = () => {
				window.removeEventListener('pointerup', release);
				window.removeEventListener('pointercancel', release);
				togglePillPress.style.transition = `transform var(--dur-pop-in) var(--ease-pop)`;
				togglePillPress.style.transform = 'scale(1)';
			};
			window.addEventListener('pointerup', release);
			window.addEventListener('pointercancel', release);
		});

		// Roll to the new label after a click flips the theme. This listener
		// registers after the flip handler above, so themeLabel() already
		// answers for the NEW state.
		//
		// ── One clock with the ink ──
		// 2026-08-06, Hiro: "there is some phasing between the two". The roll
		// used to be an rAF-deferred pair of JS transitions with a timer and a
		// reflow between them, and it ran ~2 frames behind the glyph's sweep at
		// every stage — see the measurements at @keyframes theme-label-roll in
		// global.css, which now owns the whole gesture. All this does is
		// retrigger it from frame zero, exactly the way the flip handler above
		// retriggers the sweep, so the two animations start in the same frame
		// and share --dur-gesture and --nav-ease.
		//
		// The class goes on SYNCHRONOUSLY, no rAF: an animation rides straight
		// through .theme-switching's one-frame `transition: none`, which is
		// what made the deferral necessary while this was a transition.
		const gestureMs =
			parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--dur-gesture')) ||
			200;
		// 0.2 is where --nav-ease reaches HALF its travel, so this is the frame
		// the ink crosses the circle's centre — the keyframes hold the word at
		// opacity 0 from 15% to 30% (30–60ms) so the swap lands in the middle of
		// a window rather than on a point, and a late timer still can't be seen.
		// Both numbers are derived from that curve; the block in global.css has
		// the derivation.
		const SWAP_AT = gestureMs * 0.2;
		themeToggle.addEventListener('click', () => {
			if (!shown) return;
			const text = themeLabel();
			if (reduceToggle) {
				togglePill.style.width = `${widthFor(text)}px`;
				togglePillText.textContent = text;
				return;
			}
			togglePill.classList.remove('is-rolling');
			void togglePill.offsetWidth;
			togglePill.classList.add('is-rolling');
			const seq = ++rollSeq;
			// Both of these want the NEXT frame, for two different reasons, and
			// they get one rAF between them:
			//   · the WIDTH rides a transition, and the flip's .theme-switching
			//     freeze owns this frame — "Light mode" and "Dark mode" differ by
			//     a few px and the plate must not snap;
			//   · the swap timer has to be measured from the ANIMATION's first
			//     frame, not from the click. The class above starts the roll at
			//     the next style flush — this callback — so a timer armed here
			//     lands SWAP_AT into the roll rather than SWAP_AT into the frame
			//     BEFORE it. Measured, that one frame was the difference between
			//     swapping 3ms inside the opacity-0 window and swapping on its
			//     edge, where a slow timer shows the old word flickering out.
			requestAnimationFrame(() => {
				togglePill.style.width = `${widthFor(text)}px`;
				// Read the label at FIRE time, not here: a second click inside the
				// window has already flipped the theme back, and the word the pill
				// lands on should be the one that is true when it lands. The seq
				// guard is for the other interruption — a placePill() from the
				// pointer leaving and returning, which resets the label itself.
				window.setTimeout(() => {
					if (seq !== rollSeq) return;
					togglePillText.textContent = themeLabel();
				}, SWAP_AT);
			});
		});
	}
</script>

---
import { contacts } from '../data/projects';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const onHome = path === '/';
const onAbout = path === '/about' || path === '/about/';
// The home page is the projects listing, and project detail pages live under
// the Projects section, so the Projects nav link is the active one on both.
const onProject = onHome || path.startsWith('/projects/');
---

<nav
	id="site-nav"
	data-home={onHome ? 'true' : 'false'}
	data-scrolled={onHome ? 'false' : 'true'}
	class="group/nav sticky top-0 z-40 bg-[var(--paper)]"
>
	{/* The vertical padding (nav height) snaps between states with no transition;
	    the resulting position shift is played back as a composited transform by
	    the FLIP logic in the script below. Nothing here animates a layout
	    property, so the collapse/expand never forces a per-frame reflow. */}
	<div class="mx-auto max-w-[1280px] px-5 py-12 group-data-[scrolled=true]/nav:py-1">
		{/* No flex gap here: it would also open up between the contact group and
		    the theme toggle, breaking the compact close-ranks math in global.css
		    (which assumes one uniform 0.375rem gap between all buttons). The
		    logo↔links gap lives in the links' ml-7 instead. */}
		<div class="nav-inner flex items-center">
			{/* Left cluster: wordmark + links compact as ONE unit — the wrapper
			    carries the logo's scale, so the links and the whitespace before
			    them shrink in exact proportion to the wordmark through pure
			    layout (no JS width measurement, so no dependence on which font
			    has loaded). The links counter-scale inside the shrunken wrapper
			    (see .nav-links in global.css) to land at their own, larger
			    compact size and stay readable. */}
			<div class="nav-left flex origin-left items-center transition-transform duration-200 ease-out group-data-[scrolled=true]/nav:scale-[var(--nav-logo-scale)]">
				<a href="/" class="nav-logo text-[2.5rem] font-bold tracking-tight text-[var(--ink)]">
					Hiro Eernisse
				</a>

				{/* Projects/About sit right beside the wordmark. The link for the
				    section you're on is marked active with aria-current (styled in
				    global.css). */}
				<div class="nav-links ml-7 hidden origin-left items-center gap-1 text-xl font-medium text-[var(--ink-soft)] transition-transform duration-200 ease-out sm:flex">
					<a
						href="/#projects"
						data-projects-link
						class="rounded-none px-2 py-1 transition-colors hover:text-[var(--ink)]"
						aria-current={onProject ? 'page' : undefined}
					>Projects</a>
					<a
						href="/about"
						class="rounded-none px-2 py-1 transition-colors hover:text-[var(--ink)]"
						aria-current={onAbout ? 'page' : undefined}
					>About</a>
				</div>
			</div>

		<div id="contact-group" class="relative ml-auto flex items-center gap-1.5 self-center">
			{
				contacts.map((c, i) => {
					const isEmail = c.href.startsWith('mailto:');
					const hoverLabel = isEmail ? 'Copy email' : c.label;
					return (
						<a
							href={c.href}
							class="btn-icon"
							style={`--nav-icon-r: ${contacts.length - i}`}
							aria-label={hoverLabel}
							data-label={hoverLabel}
							data-copy={isEmail ? c.href.replace('mailto:', '') : undefined}
							target={isEmail ? undefined : '_blank'}
							rel="noopener"
						>
							<Icon name={c.icon} />
						</a>
					);
				})
			}
			{/* One shared ink pill that glides between the icons on hover/focus,
			    carrying the hovered icon's label. Positioned entirely by script.
			    The ↗ shows only for external (new-tab) links. */}
			<span class="contact-slider" aria-hidden="true">
				<span class="contact-slider-text"></span>
				<svg
					class="contact-slider-ext"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="square"
					stroke-linejoin="miter"
					aria-hidden="true"
				>
					<path d="M15 3h6v6" />
					<path d="M10 14 21 3" />
					<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
				</svg>
			</span>
		</div>

		{/* Light/dark toggle: boxed by a quiet border (no fill), which sets it
		    apart from the borderless contact icons without outshouting them —
		    as does its wider ml-6 gap. The compact close-ranks slide in
		    global.css hard-codes both gaps (contact-group's gap-1.5 and this
		    ml-6); keep them in step. */}
		<button
			id="theme-toggle"
			type="button"
			class="btn-icon theme-toggle ml-6 self-center"
			aria-label="Toggle light and dark theme"
		>
			<svg
				class="icon-moon"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="square"
				stroke-linejoin="miter"
				aria-hidden="true"
			>
				<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
			</svg>
			<svg
				class="icon-sun"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="square"
				stroke-linejoin="miter"
				aria-hidden="true"
			>
				<circle cx="12" cy="12" r="4" />
				<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
			</svg>
		</button>
		</div>
	</div>
</nav>

<script is:inline>
	// Carry the nav's expand/collapse state across page navigations. Because this
	// is a multi-page app, the height change between the home masthead (expanded)
	// and interior pages (compact) can't tween across a page load on its own — so
	// we persist the nav's visual state when a page is left and diff it against
	// the new page's resting state on arrival:
	//
	//   1. pagehide: store the nav's current state (fires for every way a page
	//      can be left — link click, back/forward, address bar).
	//   2. On arrival: compute this page's resting state from first principles
	//      (home near the top → expanded, anything else → compact).
	//   3. If the carried state differs, paint in the carried state and play the
	//      difference as soon as parsing finishes.
	//
	// No per-flow special cases: collapse (home → interior) and expand
	// (anywhere → top of home) both fall out of the same diff.
	//
	// Runs inline (pre-paint) so the page paints in its *starting* state, with
	// no flash of the resting state, before animating on the next frame. The
	// intro itself also lives here rather than in the module script below:
	// module scripts evaluate in document order behind whatever the toolchain
	// injects ahead of them (in dev: the Vite client and dev toolbar), so on a
	// slow round trip the nav sat frozen in the carried state for up to a
	// second after paint. readyState 'interactive' fires before any module
	// script runs, so the intro can't be starved by them.
	(function () {
		var nav = document.getElementById('site-nav');
		if (!nav) return;
		var KEY = 'nav-state';

		window.addEventListener('pagehide', function () {
			try {
				sessionStorage.setItem(KEY, nav.dataset.scrolled + ':' + Date.now());
			} catch (e) {}
		});

		// This page's resting state right now. The 12px threshold matches
		// COLLAPSE_ABOVE in the scroll handler below, so the nav paints compact
		// the moment the page loads scrolled even slightly off the top.
		var onHome = nav.dataset.home === 'true';
		// A pending "show projects" intent — set when the Projects link is clicked
		// on another page — means this home load should rest compact, not expanded:
		// the module script scrolls to the projects view once layout is measurable,
		// and painting compact up front avoids a flash of the tall masthead.
		var wantProjects = false;
		try { wantProjects = sessionStorage.getItem('nav-projects') === '1'; } catch (e) {}
		var target = onHome && window.scrollY < 12 && !wantProjects ? 'false' : 'true';

		// The state carried over from the page we just left, if fresh. The age
		// cap means returning to a stale tab (e.g. from an external site much
		// later) paints at rest instead of replaying an old animation.
		var carried = null;
		try {
			var raw = sessionStorage.getItem(KEY);
			sessionStorage.removeItem(KEY);
			if (raw) {
				var sep = raw.lastIndexOf(':');
				if (Date.now() - +raw.slice(sep + 1) < 10000) carried = raw.slice(0, sep);
			}
		} catch (e) {}

		var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		var animate = !reduce && (carried === 'true' || carried === 'false') && carried !== target;

		// Paint pre-paint in the starting state (carried if animating, else rest),
		// transitions suppressed so this snap can't tween from the SSR default.
		nav.classList.add('nav-no-transition');
		nav.dataset.scrolled = animate ? carried : target;
		void nav.offsetWidth;
		nav.classList.remove('nav-no-transition');
		if (!animate) return;

		// FLIP the carried→resting difference (a one-shot copy of animateTo in
		// the module script below — keep the two in step): snap the height
		// change, measure how far each affected block moved, offset it back,
		// then release the offset as a composited transform.
		var runIntro = function () {
			// Recompute the resting state rather than reusing `target`:
			// back/forward scroll restoration can land before this runs (e.g.
			// returning to a scrolled-down home), and if the restored position
			// already matches the painted state there is nothing to animate.
			var to = onHome && window.scrollY < 12 ? 'false' : 'true';
			if (nav.dataset.scrolled === to) return;
			var els = [
				nav.querySelector('.nav-inner'),
				document.querySelector('main'),
				document.querySelector('footer'),
			].filter(Boolean);
			var first = els.map(function (el) {
				return el.getBoundingClientRect().top;
			});
			nav.dataset.scrolled = to; // snap the height; start CSS scale transitions
			var last = els.map(function (el) {
				return el.getBoundingClientRect().top;
			});
			els.forEach(function (el, i) {
				var dy = first[i] - last[i];
				el.style.transition = 'none';
				el.style.transform = dy ? 'translateY(' + dy + 'px)' : '';
			});
			void nav.offsetWidth;
			// Release synchronously — NOT on the next rAF. The scale/translateX
			// transitions above started at this task's style clock; releasing a
			// frame later would start the vertical glide ~16ms behind them, and
			// that per-axis lag bends every straight diagonal into an arc (an
			// oval over a collapse+expand round trip). Same-task release gives
			// all axes the identical start time on any refresh rate.
			els.forEach(function (el) {
				el.style.transition = 'transform 200ms var(--nav-ease)';
				el.style.transform = '';
				el.addEventListener('transitionend', function done() {
					el.style.transition = '';
					el.removeEventListener('transitionend', done);
				});
			});
			void nav.offsetWidth;
		};

		// 'interactive' means main/footer exist and layout is measurable; it
		// fires before module scripts evaluate, so this can't run twice against
		// the scroll handler installed below.
		if (document.readyState !== 'loading') {
			runIntro();
		} else {
			document.addEventListener('readystatechange', function onReady() {
				document.removeEventListener('readystatechange', onReady);
				runIntro();
			});
		}
	})();
</script>

<script>
	// ── Theme toggle ──
	// Flip <html data-theme> and remember the manual choice. The initial theme
	// is resolved pre-paint in Layout.astro; this only handles user clicks.
	const themeToggle = document.getElementById('theme-toggle');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const syncThemeLabel = () => {
		const dark = document.documentElement.dataset.theme === 'dark';
		themeToggle?.setAttribute(
			'aria-label',
			dark ? 'Switch to light theme' : 'Switch to dark theme',
		);
	};
	syncThemeLabel();
	themeToggle?.addEventListener('click', () => {
		const root = document.documentElement;
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		// Suppress every transition for the frame the theme flips so the whole
		// page changes at once — no element animates on its own clock, and grey
		// text never dips through a low-contrast mid-tone. Force a style flush
		// with transitions off, then re-enable them on the next frame.
		root.classList.add('theme-switching');
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch (e) {}
		syncThemeLabel();
		// Play the sun/moon swap. It's a keyframe animation (unaffected by the
		// transition suppression above), retriggered by removing the class and
		// forcing a reflow before re-adding so rapid clicks restart it cleanly.
		if (themeToggle && !prefersReducedMotion.matches) {
			themeToggle.classList.remove('theme-anim');
			void themeToggle.offsetWidth;
			themeToggle.classList.add('theme-anim');
		}
		void root.offsetHeight;
		requestAnimationFrame(() => root.classList.remove('theme-switching'));
	});

	const nav = document.getElementById('site-nav');
	if (nav) {
		// The collapse/expand changes the nav's height, which shifts the bar's
		// content and everything below it. Animating that shift with a layout
		// property (padding/font-size) forces a reflow every frame — the source
		// of the stutter. Instead we use FLIP: snap the height change instantly
		// (invisible, as the nav has no visible bottom edge), measure how far each
		// affected block moved, then play that delta back as a composited
		// `transform`. Only transforms animate per frame, so there is no reflow.
		// (The name/links/icons scale via their own CSS transform transitions.)
		const DUR = 200;
		const barInner = nav.querySelector('.nav-inner');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// The bar content plus every block that flows after the sticky nav.
		const shiftables = () =>
			[barInner, document.querySelector('main'), document.querySelector('footer')].filter(Boolean);

		// Set the state with no animation (initial paint, reduced motion).
		const snap = (next) => {
			nav.classList.add('nav-no-transition');
			nav.dataset.scrolled = next;
			void nav.offsetWidth;
			nav.classList.remove('nav-no-transition');
		};

		const animateTo = (next) => {
			if (nav.dataset.scrolled === next) return;
			if (reduceMotion) { snap(next); return; }
			const els = shiftables();
			// Clear any in-flight transform so we measure true layout positions.
			els.forEach((el) => { el.style.transition = 'none'; el.style.transform = ''; });
			void nav.offsetWidth;
			const first = els.map((el) => el.getBoundingClientRect().top);
			nav.dataset.scrolled = next; // snap the height; start CSS scale transitions
			const last = els.map((el) => el.getBoundingClientRect().top);
			// Invert: offset each block back to where it was, with transitions off.
			els.forEach((el, i) => {
				const dy = first[i] - last[i];
				el.style.transform = dy ? `translateY(${dy}px)` : '';
			});
			void nav.offsetWidth;
			// Play: release the offsets so they glide to zero on the compositor.
			// Released in the same task (with a forced style flush), not on the
			// next rAF: the children's scale/translateX transitions started at
			// this task's style clock, and a one-frame-later vertical start bends
			// the straight diagonals into arcs — an oval over a collapse+expand
			// round trip. (Same pattern in the inline intro above.)
			els.forEach((el) => {
				el.style.transition = `transform ${DUR}ms var(--nav-ease)`;
				el.style.transform = '';
				el.addEventListener('transitionend', function done() {
					el.style.transition = '';
					el.removeEventListener('transitionend', done);
				});
			});
			void nav.offsetWidth;
		};

		// (The cross-page intro is played by the inline script above, which runs
		// at readyState 'interactive' — before this module evaluates — so it
		// can't be starved by the module chain. animateTo here only serves the
		// scroll handler; its transform-clearing preamble also lets it cleanly
		// take over from an intro still in flight.)

		// ── "Projects" → projects section, compact nav ──
		// The projects list is the top of the home page, sitting directly under the
		// masthead. A plain #projects anchor fights the sticky collapse: once the nav
		// is compact, the section's document top is nearer the viewport top than the
		// anchor's scroll-margin (95px), so the browser clamps the jump to y=0 —
		// snapping back to the very top with the masthead re-expanded. So we take
		// over: scroll to the spot where the nav is collapsed and the first card sits
		// just beneath it. Cross-page, a sessionStorage flag carries the intent so the
		// home page lands there directly (see the inline script's `wantProjects`).
		const PROJECTS_FLAG = 'nav-projects';

		// The y that leaves the nav compact with the first card just below it.
		const projectsTargetY = () => {
			const list = document.getElementById('project-list');
			if (!list) return null;
			// Gap from the nav's bottom edge to the first card — the section's top
			// padding. It's independent of nav state: the card's document position
			// and the nav's box height shift together between expanded and compact,
			// so this difference is the same either way.
			const contentGap = list.getBoundingClientRect().top + window.scrollY - nav.offsetHeight;
			// Land the card ~12px under the compact nav, but never so near the top
			// that the scroll handler's 12px threshold would re-expand the masthead.
			return Math.max(contentGap - 12, 16);
		};

		const goToProjects = (smooth) => {
			const y = projectsTargetY();
			if (y == null) return;
			window.scrollTo({ top: y, behavior: smooth && !reduceMotion ? 'smooth' : 'auto' });
		};

		// Intercept the Projects link on every page. On home we scroll in place; from
		// elsewhere we stash the intent and navigate to a clean "/" (no #projects, so
		// the browser's own anchor jump can't fire and fight us).
		document.querySelectorAll('a[data-projects-link]').forEach((link) => {
			link.addEventListener('click', (e) => {
				if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
				e.preventDefault();
				if (nav.dataset.home === 'true') {
					history.replaceState(null, '', '/');
					goToProjects(true);
				} else {
					try { sessionStorage.setItem(PROJECTS_FLAG, '1'); } catch (err) {}
					window.location.href = '/';
				}
			});
		});

		// Home masthead: expand near the very top, collapse once scrolled, with a
		// dead-band so scroll jitter can't rapidly re-trigger the animation.
		// (The initial state is already painted by the inline script above;
		// COLLAPSE_ABOVE must stay in sync with the 12px threshold there.)
		if (nav.dataset.home === 'true') {
			// Cross-page arrival with a pending Projects intent: the nav was already
			// painted compact by the inline script, so just settle onto the projects
			// view (instant — this is the landing, not a same-page transition).
			let wantProjects = false;
			try {
				wantProjects = sessionStorage.getItem(PROJECTS_FLAG) === '1';
				sessionStorage.removeItem(PROJECTS_FLAG);
			} catch (err) {}
			if (wantProjects) goToProjects(false);

			const EXPAND_BELOW = 4;
			const COLLAPSE_ABOVE = 12;
			let scrolled = window.scrollY > COLLAPSE_ABOVE;
			let ticking = false;
			const apply = () => {
				ticking = false;
				const y = window.scrollY;
				if (!scrolled && y > COLLAPSE_ABOVE) scrolled = true;
				else if (scrolled && y < EXPAND_BELOW) scrolled = false;
				else return;
				animateTo(scrolled ? 'true' : 'false');
			};
			window.addEventListener(
				'scroll',
				() => {
					if (!ticking) {
						ticking = true;
						requestAnimationFrame(apply);
					}
				},
				{ passive: true }
			);
		}
	}

	// ── Sliding contact label ──
	// A single ink pill glides between the contact icons, always sitting under
	// whichever one is hovered or focused, and carrying that icon's label. When
	// moving between icons it slides + resizes; on appearance it wipes in left
	// to right, and on hide it wipes back out right to left (no slide from the
	// corner, no fade) — the same in/out grammar as the nav links' underline.
	const group = document.getElementById('contact-group');
	const pill = group?.querySelector<HTMLElement>('.contact-slider');
	const pillText = pill?.querySelector<HTMLElement>('.contact-slider-text');

	if (group && pill && pillText) {
		const icons = Array.from(group.querySelectorAll<HTMLAnchorElement>('.btn-icon'));

		// Hidden clone of the pill, used to measure the exact width each label
		// needs — including the external-link arrow when shown — so the pill's
		// width can animate to an explicit px value.
		const measurer = pill.cloneNode(true) as HTMLElement;
		measurer.style.cssText =
			'position:absolute;visibility:hidden;top:-9999px;left:0;opacity:1;transform:none;transition:none;width:auto;';
		group.appendChild(measurer);
		const measurerText = measurer.querySelector<HTMLElement>('.contact-slider-text')!;

		let visible = false;
		let resetTimer = 0;
		let swapSeq = 0;
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const labelFor = (icon: HTMLElement) => icon.getAttribute('data-label') ?? '';
		const isExternal = (icon: HTMLElement) => icon.getAttribute('target') === '_blank';

		// Drop any in-flight roll animation and return the text to a clean,
		// visible resting state (used before every direct repositioning).
		const resetText = () => {
			swapSeq++;
			pillText.style.transition = 'none';
			pillText.style.transform = 'none';
			pillText.style.opacity = '1';
		};

		// Position + size the pill under `icon`, showing `text`. Links that open
		// in a new tab also get the trailing ↗ arrow.
		const place = (icon: HTMLElement, text: string) => {
			const gRect = group.getBoundingClientRect();
			const iRect = icon.getBoundingClientRect();
			const centerX = iRect.left - gRect.left + iRect.width / 2;
			const external = isExternal(icon);
			resetText();
			measurerText.textContent = text;
			measurer.classList.toggle('is-external', external);
			pillText.textContent = text;
			pill.classList.toggle('is-external', external);
			pill.style.width = `${measurer.offsetWidth}px`;
			pill.style.transform = `translateX(${centerX}px) translateX(-50%)`;
		};

		// Roll the current text up and out, then roll `text` up into place —
		// used for the copy feedback, so "Copied!" animates in and back without
		// resizing the pill.
		const swapText = (text: string) => {
			if (reduce) {
				pillText.textContent = text;
				return;
			}
			const seq = ++swapSeq;
			pillText.style.transition = 'transform 0.08s ease, opacity 0.08s ease';
			pillText.style.transform = 'translateY(-100%)';
			pillText.style.opacity = '0';
			window.setTimeout(() => {
				if (seq !== swapSeq) return; // superseded
				pillText.textContent = text;
				pillText.style.transition = 'none';
				pillText.style.transform = 'translateY(100%)';
				pillText.style.opacity = '0';
				void pillText.offsetHeight; // reflow so the entry animates
				pillText.style.transition =
					'transform 0.12s cubic-bezier(0.34, 1.35, 0.64, 1), opacity 0.1s ease';
				pillText.style.transform = 'translateY(0)';
				pillText.style.opacity = '1';
			}, 80);
		};

		const showAt = (icon: HTMLElement, text = labelFor(icon)) => {
			if (visible) {
				pill.style.opacity = '1';
				place(icon, text); // slide + resize to the new icon
			} else {
				// Appear with a left-to-right wipe (matching the nav-link
				// underline) rather than a fade: kill transitions, position it
				// fully clipped from the right edge, then release the clip so the
				// label reveals left to right. Reduced motion just snaps it in.
				pill.style.transition = 'none';
				place(icon, text);
				pill.style.opacity = '1';
				pill.style.clipPath = reduce ? 'inset(0 0 0 0)' : 'inset(0 100% 0 0)';
				void pill.offsetWidth; // force reflow so the wipe animates from clipped
				pill.style.transition = '';
				pill.style.clipPath = 'inset(0 0 0 0)';
				visible = true;
			}
		};

		const hide = () => {
			visible = false;
			// Wipe out right-to-left — the entrance wipe played in reverse, the
			// same in/out symmetry as the nav links' underline (which grows from
			// and retracts toward its left edge). Opacity stays 1; the pill is
			// hidden purely by the clip. Reduced motion snaps it away instead.
			if (reduce) {
				pill.style.transition = 'none';
				pill.style.clipPath = 'inset(0 100% 0 0)';
				void pill.offsetWidth;
				pill.style.transition = '';
				return;
			}
			pill.style.clipPath = 'inset(0 100% 0 0)';
		};

		// Show the label only while the cursor is actually over an icon. Slipping
		// into a gap between two icons doesn't hide instantly — a short grace
		// delay lets a sweep to the next icon cancel the hide and keep the pill
		// gliding — but lingering in the gap clears the label.
		let gapHideTimer = 0;
		icons.forEach((icon) => {
			icon.addEventListener('mouseenter', () => {
				window.clearTimeout(gapHideTimer);
				showAt(icon);
			});
			icon.addEventListener('mouseleave', () => {
				window.clearTimeout(gapHideTimer);
				gapHideTimer = window.setTimeout(hide, 90);
			});
		});
		group.addEventListener('mouseleave', () => {
			window.clearTimeout(gapHideTimer);
			hide();
		});
		group.addEventListener('focusin', (e) => {
			const icon = (e.target as HTMLElement).closest<HTMLElement>('.btn-icon');
			if (icon) showAt(icon);
		});
		group.addEventListener('focusout', (e) => {
			if (!group.contains(e.relatedTarget as Node)) hide();
		});

		// Copy-to-clipboard: swap the pill text to feedback, then restore. On
		// success we swap the text only — keeping the rectangle at the "Copy
		// email" width so it doesn't resize. The (rare) fallback hint is longer,
		// so that one does resize to stay readable.
		icons.forEach((icon) => {
			const address = icon.dataset.copy;
			if (!address) return;
			icon.addEventListener('click', async (e) => {
				e.preventDefault();
				let ok = true;
				try {
					await navigator.clipboard.writeText(address);
				} catch {
					ok = false;
				}
				window.clearTimeout(resetTimer);
				if (ok) {
					if (!visible) showAt(icon);
					swapText('Copied!'); // roll in, same width
					resetTimer = window.setTimeout(() => {
						if (visible) swapText(labelFor(icon)); // roll back
					}, 1500);
				} else {
					showAt(icon, 'Press ⌘C to copy'); // longer hint: resize to fit
					resetTimer = window.setTimeout(() => {
						if (visible) place(icon, labelFor(icon));
					}, 1500);
				}
			});
		});
	}
</script>

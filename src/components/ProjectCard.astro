---
import type { Project } from '../data/projects';
interface Props {
	project: Project;
	reversed?: boolean;
}
const { project, reversed = false } = Astro.props;
---

<a
	href={`/projects/${project.slug}`}
	class:list={[
		'@container group flex flex-col overflow-hidden rounded-sm border border-black/15 bg-white transition-colors duration-300 hover:border-[var(--ink)] md:h-80',
		reversed ? 'md:flex-row-reverse' : 'md:flex-row',
	]}
>
	<div
		class:list={[
			'overflow-hidden border-black/10 bg-neutral-100 transition-[width] duration-300 ease-out md:w-[74%] md:group-hover:w-[52%]',
			'border-b md:border-b-0',
			reversed ? 'md:border-l' : 'md:border-r',
		]}
	>
		<div class="aspect-[16/10] h-full w-full overflow-hidden md:aspect-auto">
			<img
				src={project.cover}
				alt={project.title}
				loading="lazy"
				class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
			/>
		</div>
	</div>
	<div class="flex items-center overflow-hidden p-5 transition-[width] duration-300 ease-out md:w-[26%] md:p-6 md:group-hover:w-[48%]">
		<div class="w-full origin-left transition-transform duration-300 ease-out md:w-[44cqw] md:shrink-0 md:scale-[0.5] md:group-hover:scale-100">
			<div class="flex items-baseline justify-between gap-3">
				<h3 class="text-sm font-bold tracking-tight text-[var(--ink)] md:text-[2rem]">
					{project.title}
				</h3>
				<span class="shrink-0 text-xs text-[var(--ink-soft)]">{project.year}</span>
			</div>
			<p class="mt-3 text-[0.7rem] leading-relaxed text-[var(--ink-soft)] md:text-[1.375rem]">{project.blurb}</p>
			<div class="mt-4 flex flex-wrap gap-2">
				{
					project.tags.map((tag) => (
						<span class="rounded-sm border border-black/12 px-2 py-0.5 text-xs text-[var(--ink-soft)]">
							{tag}
						</span>
					))
				}
			</div>
		</div>
	</div>
</a>

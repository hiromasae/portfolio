---
import type { Project } from '../data/projects';
interface Props {
	project: Project;
}
const { project } = Astro.props;
---

<a
	id={`project-${project.slug}`}
	href={`/projects/${project.slug}`}
	class:list={[
		'project-card group flex flex-col gap-5 scroll-mt-24 rounded-[1.5px]',
		'transition-[scale] duration-[var(--dur-card)] ease-out',
		'hover:scale-[1.02] focus-within:scale-[1.02] active:scale-[0.99]',
		'motion-reduce:hover:scale-100 motion-reduce:focus-within:scale-100 motion-reduce:active:scale-100',
		'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--focus-ring)]',
	]}
>
	{/* Metadata sits on the page background — reading as a label above the image,
	    not inside a card. */}
	<div class="flex min-w-0 flex-col gap-1">
		{/* Dateline above the title: just the year, small and muted. */}
		<span class="text-[0.8rem] font-medium tabular-nums text-[var(--ink-soft)]">{project.year}</span>
		{/* Title-only underline that wipes in left-to-right on hover/focus — the
		    site's nav-underline gesture — alongside the card zoom. The underline
		    targets .project-card__title in global.css. */}
		<h3 class="text-lg font-bold tracking-tight text-[var(--ink)] md:text-[1.3rem] md:leading-tight">
			<span class="project-card__title">{project.title}</span>
			{/* A right-pointing arrow that wipes in left-to-right once the title
			    underline finishes, then tilts up to point ↗. Choreography lives
			    with the underline rules in global.css (.project-card__arrow).
			    Decorative — the whole card is the link. */}
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
				class="project-card__arrow ml-2 inline-block h-[1.1rem] w-[1.1rem] align-[-0.125em]"
			>
				<line x1="4" y1="12" x2="19" y2="12"></line>
				<polyline points="12 5 19 12 12 19"></polyline>
			</svg>
		</h3>
		{/* One-line "what I did" under the title, so the role reads before the image.
		    Negative margin pulls it tighter to the title than the column's gap-1. */}
		<p class="-mt-0.5 max-w-2xl text-[0.95rem] leading-snug text-[var(--ink-soft)]">{project.role}</p>
	</div>

	{/* The image is the card: it carries the border and shadow. The whole link
	    zooms as one unit on hover (scale on the <a>), so the blended metadata
	    above scales along with it. */}
	<div
		class:list={[
			'relative aspect-[16/9] w-full overflow-hidden rounded-[1.5px] border border-[var(--line)] bg-[var(--surface-sunken)]',
			'shadow-[0_1px_1px_rgba(0,0,0,0.03),0_10px_30px_-16px_rgba(0,0,0,0.15)]',
		]}
	>
		<img
			src={project.cover}
			alt={project.title}
			loading="lazy"
			decoding="async"
			class="absolute inset-0 h-full w-full object-cover object-top"
		/>
	</div>
</a>

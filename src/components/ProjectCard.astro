---
import type { Project } from '../data/projects';
interface Props {
	project: Project;
	reversed?: boolean;
}
const { project, reversed = false } = Astro.props;
---

<a
	href={`/projects/${project.slug}`}
	class:list={[
		'@container group flex flex-col overflow-hidden rounded-[1.5px] border border-[var(--line)] bg-[var(--surface)] md:h-[78vh]',
		'shadow-[0_1px_1px_rgba(0,0,0,0.03),0_10px_30px_-16px_rgba(0,0,0,0.15)] transition-[box-shadow,border-color,background-color,transform] duration-300 ease-out',
		'hover:border-[var(--line-strong)] hover:shadow-[0_2px_3px_rgba(0,0,0,0.04),0_18px_44px_-18px_rgba(0,0,0,0.24)]',
		'active:scale-[0.99] active:border-[var(--ink)] active:bg-[var(--surface-sunken)] active:shadow-[0_1px_1px_rgba(0,0,0,0.04),0_6px_16px_-14px_rgba(0,0,0,0.2)]',
		reversed ? 'md:flex-row-reverse' : 'md:flex-row',
	]}
>
	<div
		class:list={[
			'overflow-hidden border-[var(--line)] bg-[var(--surface-sunken)] transition-[width,background-color] duration-300 ease-out md:w-[74%] md:group-hover:w-[52%]',
			'border-b md:border-b-0',
			reversed ? 'md:border-l' : 'md:border-r',
		]}
	>
		<div class="aspect-[16/10] h-full w-full overflow-hidden md:aspect-auto">
			<img
				src={project.cover}
				alt={project.title}
				loading="lazy"
				decoding="async"
				class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
			/>
		</div>
	</div>
	<div class="flex items-center overflow-hidden p-5 transition-[width] duration-300 ease-out md:w-[26%] md:p-6 md:group-hover:w-[48%]">
		<div class="w-full origin-left transition-transform duration-300 ease-out md:w-[44cqw] md:shrink-0 md:scale-[0.5] md:group-hover:scale-[0.8]">
			<div class="flex items-baseline justify-between gap-3">
				<h3 class="text-sm font-bold tracking-tight text-[var(--ink)] md:text-[2rem]">
					{project.title}
				</h3>
				<span class="shrink-0 text-xs text-[var(--ink-soft)]">{project.year}</span>
			</div>
			<p class="mt-3 text-[0.7rem] leading-relaxed text-[var(--ink-soft)] md:text-[1.375rem]">{project.blurb}</p>
		</div>
	</div>
</a>

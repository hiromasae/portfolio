---
import type { Project } from '../data/projects';
interface Props {
	project: Project;
}
const { project } = Astro.props;
---

<a
	id={`project-${project.slug}`}
	href={`/projects/${project.slug}`}
	class:list={[
		'project-card group flex flex-col gap-4 scroll-mt-24 rounded-[1.5px]',
		'transition-[scale,translate] duration-[var(--dur-card)] ease-out',
		/* origin-top, not the default centre: scaling about the centre lifts the
		   top edge by half the growth, so the heading rose on hover while the
		   meta gap below it was opening — two conflicting reads of the same
		   gesture. Anchored at the top, the heading holds its line and the whole
		   card grows downward, the same direction the gap opens. */
		'origin-top',
		'hover:scale-[1.02] focus-within:scale-[1.02] active:scale-[0.99]',
		/* The lift. A scale about a pinned top edge displaces every part in
		   proportion to its distance from that edge — title 0px, role line
		   +0.73, image top edge +1.61, card bottom edge +15.3 — so no two parts
		   of the card travel together and the whole thing reads as separate
		   pieces resizing rather than one object moving. This translate is the
		   only displacement they share.

		   It does NOT make the motion rigid: at 3px the top of the card rises
		   while the bottom edge still drops ~12px, and squaring that would take
		   a 15.4px lift, which is far too much. What it buys is the top edge
		   coming off the page instead of staying pinned, and the metadata
		   participating in the lift — it has no border of its own, so without
		   this the frame's shadow was the only depth cue on the card and only
		   the image appeared to rise.

		   Same duration and curve as the zoom, so the two are one gesture.
		   Press cancels it (active:translate-y-0), pairing with the 0.99 scale
		   so the card settles back onto the page under the finger. */
		'hover:-translate-y-[3px] focus-within:-translate-y-[3px] active:translate-y-0',
		'motion-reduce:hover:scale-100 motion-reduce:focus-within:scale-100 motion-reduce:active:scale-100',
		'motion-reduce:hover:translate-y-0 motion-reduce:focus-within:translate-y-0',
		'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--focus-ring)]',
	]}
>
	{/* Metadata sits on the page background — reading as a label above the image,
	    not inside a card. */}
	{/* The column has exactly two children, so this gap is the whole
	    title/metadata rhythm — no per-child margins fighting it. */}
	<div class="flex min-w-0 flex-col gap-1">
		{/* Title-only underline that wipes in left-to-right on hover/focus — the
		    site's shared underline gesture — alongside the card zoom. The underline
		    targets .project-card__title in global.css. */}
		{/* Stepped down a size when the list went two-up (2026-08-01): at half the
		    old column width, 1.3rem titles ran to three lines on the longer ones
		    and the card read as a headline with a picture under it rather than a
		    piece of work with a name. */}
		<h3 class="text-base font-bold tracking-tight text-[var(--ink-title)] md:text-[1.1rem] md:leading-tight">
			<span class="project-card__title">{project.title}</span>
			{/* A right-pointing arrow that wipes in left-to-right once the title
			    underline finishes, then tilts up to point ↗. Choreography lives
			    with the underline rules in global.css (.project-card__arrow).
			    Decorative — the whole card is the link. */}
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
				class="project-card__arrow ml-2 inline-block h-[0.95rem] w-[0.95rem] align-[-0.125em]"
			>
				<line x1="4" y1="12" x2="19" y2="12"></line>
				<polyline points="12 5 19 12 12 19"></polyline>
			</svg>
		</h3>
		{/* One-line "what I did" under the title, so the role reads before the image.
		    The year leads this line rather than taking a dateline of its own above
		    the title: it's the thinnest fact on the card and a whole line of rhythm
		    for four characters pushed the title off the top of the block. Same size
		    and tone as the role, so the two read as one quiet metadata line and the
		    title stays the only thing above it. */}
		{/* Down with the title for the two-up list; the card's own width is the
		    measure now, so no max-w is needed on top of it. */}
		<p class="text-[0.85rem] leading-snug text-[var(--ink-soft)]">
			<span class="tabular-nums text-[var(--ink-num)]">{project.year}</span>
			<span aria-hidden="true"> · </span>
			{project.role}
		</p>
	</div>

	{/* The image is the card: it carries the border. The whole link zooms and
	    lifts as one unit on hover (scale + translate on the <a>), so the
	    blended metadata above rises along with it. This frame is the only
	    bordered surface, so it's the only thing that can carry a shadow — the
	    lift on the <a> is what keeps the metadata from being left behind. The
	    shadow is hover-only and lives with the other card hover choreography
	    in global.css (.project-card__frame).

	    bg-clip-padding keeps the --surface-sunken bed out of the border area.
	    --line is translucent, so it takes the colour of whatever sits behind
	    it: painting the bed under the border (the default border-box clip)
	    composited it over --surface-sunken instead of the page's paper and rendered
	    the edge ~7/255 darker than the about photo's identical border in
	    light, and ~13/255 lighter in dark. Clipping to the padding box lets
	    it composite over paper, like the about <img> which has no background
	    of its own — same token, same result. Keep the two in step. */}
	<div
		class:list={[
			'project-card__frame',
			'relative aspect-[16/9] w-full overflow-hidden rounded-[1.5px] border border-[var(--line)] bg-[var(--surface-sunken)] bg-clip-padding',
		]}
	>
		<img
			src={project.cover}
			alt={project.title}
			loading="lazy"
			decoding="async"
			class="absolute inset-0 h-full w-full object-cover object-top"
		/>
	</div>
</a>

---
import type { Project } from '../data/projects';
interface Props {
	project: Project;
}
const { project } = Astro.props;
---

<a
	id={`project-${project.slug}`}
	href={`/projects/${project.slug}`}
	class:list={[
		'project-card group flex flex-col gap-5 scroll-mt-24 rounded-[1.5px]',
		'transition-[scale] duration-300 ease-out',
		'hover:scale-[1.02] focus-within:scale-[1.02] active:scale-[0.99]',
		'motion-reduce:hover:scale-100 motion-reduce:focus-within:scale-100 motion-reduce:active:scale-100',
		'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--focus-ring)]',
	]}
>
	{/* Metadata sits on the page background — reading as a label above the image,
	    not inside a card. overflow-hidden clips the parked "View" at the right edge. */}
	<div class="flex items-center justify-between gap-3.5 overflow-hidden">
		<div class="flex min-w-0 flex-1 flex-col gap-1.5">
			<span class="text-[0.8rem] font-medium text-[var(--ink-soft)]">
				{project.year} · {project.tags.join(', ')}
			</span>
			{/* Title-only underline that wipes in left-to-right on hover/focus — the
			    site's nav-underline gesture — alongside the card zoom. See the scoped
			    <style> below; width grows 0% → 100% and snaps under reduced motion. */}
			<h3 class="text-lg font-bold tracking-tight text-[var(--ink)] md:text-[1.3rem] md:leading-tight">
				<span class="project-card__title">{project.title}</span>
			</h3>
		</div>

		{/* "View" is parked off the right edge with its layout slot reserved, so the
		    row never reflows. On hover or keyboard focus it slides into place —
		    entering from off-card. Decorative: the whole card is the link. */}
		<span
			aria-hidden="true"
			class:list={[
				'flex flex-none items-center gap-2 whitespace-nowrap text-[1rem] font-semibold text-[var(--ink)]',
				'translate-x-[calc(100%+1.4rem)] transition-transform duration-[340ms] ease-out',
				'group-hover:translate-x-0 group-focus-within:translate-x-0 motion-reduce:transition-none',
			]}
		>
			<span>View</span>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
				class="h-[1.2rem] w-[1.2rem]"
			>
				<line x1="7" y1="17" x2="17" y2="7"></line>
				<polyline points="7 7 17 7 17 17"></polyline>
			</svg>
		</span>
	</div>

	{/* The image is the card: it carries the border and shadow. The whole link
	    zooms as one unit on hover (scale on the <a>), so the blended metadata
	    above scales along with it. */}
	<div
		class:list={[
			'relative aspect-[16/9] w-full overflow-hidden rounded-[1.5px] border border-[var(--line)] bg-[var(--surface-sunken)]',
			'shadow-[0_1px_1px_rgba(0,0,0,0.03),0_10px_30px_-16px_rgba(0,0,0,0.15)]',
		]}
	>
		<img
			src={project.cover}
			alt={project.title}
			loading="lazy"
			decoding="async"
			class="absolute inset-0 h-full w-full object-cover object-top"
		/>
	</div>
</a>

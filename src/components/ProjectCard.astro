---
import type { Project } from '../data/projects';
interface Props {
	project: Project;
}
const { project } = Astro.props;
---

<a
	id={`project-${project.slug}`}
	href={`/projects/${project.slug}`}
	class:list={[
		'group relative flex flex-col overflow-hidden rounded-[1.5px] scroll-mt-24 border border-[var(--line)] bg-[var(--surface)]',
		'shadow-[0_1px_1px_rgba(0,0,0,0.03),0_10px_30px_-16px_rgba(0,0,0,0.15)]',
		'transition-[scale,box-shadow,border-color] duration-300 ease-out',
		'hover:scale-[1.02] hover:border-[var(--line-strong)] hover:shadow-[0_2px_3px_rgba(0,0,0,0.04),0_18px_44px_-18px_rgba(0,0,0,0.24)]',
		'motion-reduce:hover:scale-100',
		'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--focus-ring)]',
	]}
>
	{/* Metadata pinned at the top; the title always reads at a glance. */}
	<div class="flex items-center justify-between gap-3.5 px-[1.15rem] pt-4 pb-[0.95rem]">
		<div class="flex min-w-0 flex-1 flex-col gap-1.5">
			<span class="text-[0.8rem] font-medium text-[var(--ink-soft)]">
				{project.year} · {project.tags.join(', ')}
			</span>
			<h3 class="text-lg font-bold tracking-tight text-[var(--ink)] md:text-[1.3rem] md:leading-tight">
				{project.title}
			</h3>
		</div>

		{/* "View" is parked off the card's right edge (the card's overflow clips it)
		    with its layout slot reserved, so the row never reflows. On hover or
		    keyboard focus it slides into place — entering from off-card. Decorative:
		    the whole card is the link, named by the title. */}
		<span
			aria-hidden="true"
			class:list={[
				'flex flex-none items-center gap-2 whitespace-nowrap text-[1rem] font-semibold text-[var(--ink)]',
				'translate-x-[calc(100%+1.4rem)] transition-transform duration-[340ms] ease-out',
				'group-hover:translate-x-0 group-focus-within:translate-x-0 motion-reduce:transition-none',
			]}
		>
			<span>View</span>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
				class="h-[1.2rem] w-[1.2rem]"
			>
				<line x1="7" y1="17" x2="17" y2="7"></line>
				<polyline points="7 7 17 7 17 17"></polyline>
			</svg>
		</span>
	</div>

	<div class="relative aspect-[16/9] w-full overflow-hidden bg-[var(--surface-sunken)]">
		<img
			src={project.cover}
			alt={project.title}
			loading="lazy"
			decoding="async"
			class="absolute inset-0 h-full w-full object-cover object-top"
		/>
	</div>
</a>

---
import ProjectCard from './ProjectCard.astro';
import type { Project } from '../data/projects';

/* ── The projects grid and its travelling hover panel (2026-08-10) ──
   Extracted verbatim from index.astro the day the project pages grew a "More
   projects" strip. Nothing about the markup, the CSS hooks or the script
   changed in the move — this file is the home page's grid, lifted whole, so
   that the second consumer gets the SAME hover rather than a second answer to
   it. Read the git history of index.astro for anything predating today; every
   comment below came across with the code it annotates.

   WHY A COMPONENT AND NOT A COPY: the panel is a single element shared by every
   card in a grid, driven by a script that measures offsets against the grid
   box. Duplicating that on the project page would have meant two copies of a
   140-line choreography drifting apart at the first tweak. It also puts the
   panel element and the script that owns it in one file, which is where the
   "MUST STAY FIRST" invariant below can actually be enforced.

   ⚠ ONE PER PAGE. The id is hard-coded because every CSS hook keys off it —
   #project-list is the panel's containing block and offsetParent, and the
   :has(:active) press clock hangs on it. Two on a page would give the
   second one no panel (the script binds getElementById) and duplicate element
   ids. If a page ever needs two grids, this has to take the id as a prop and
   the CSS has to become a class first. */

interface Props {
	projects: Project[];
	/* The caller owns .reveal and --i. Whether this grid is its own entry in a
	   page's cascade or rides inside a parent's is a PAGE-level decision, and
	   getting it wrong is not cosmetic: a .reveal inside a .reveal animates
	   opacity against a parent already animating opacity, so the block arrives
	   twice. The home page passes `reveal` + --i 1 (it is the second of two
	   blocks); the project page passes neither, because the section wrapping it
	   there carries the reveal instead. */
	class?: string;
	style?: string;
	/* How many columns from sm up. Two unless a caller says otherwise — that is
	   the home page's grid and the shape every measurement in this file was
	   taken against. The project page's strip passes 3 so its cards land in one
	   row (2026-08-11, Hiro); see the note over the class list for what a wider
	   grid costs and where it stops paying. */
	columns?: 2 | 3;
	/* How many cards show before "Show more" is pressed. Omitted means the
	   whole list at once, which is what the project page's strip wants and what
	   this grid did everywhere until 2026-08-15 (Hiro: only show four project
	   cards initially on the home page with a load more button).

	   PROGRESSIVE, NOT CONDITIONAL RENDERING: every card is in the HTML either
	   way, and the ones past this count are hidden by a CSS rule that only
	   applies while the list carries .is-collapsed — a class the inline script
	   below adds. So the no-JS reading is the FULL list with no button, rather
	   than a truncated list behind a control that can't work, and a crawler
	   sees every project. It also means the panel script needs no rebinding
	   when cards appear: they were always in the DOM and always bound.

	   The count is a request, not a promise. Passing a number at or above the
	   list length collapses nothing and draws no button (see `deferredFrom`) —
	   worth knowing before adding the fifth project makes this grid's own
	   button appear or disappear. */
	initial?: number;
}

const { projects: items, class: className, style, columns = 2, initial } = Astro.props;

/* The index the deferred run starts at, or items.length for "none deferred".
   Both guards matter: no `initial` is the project page's strip, and an
   `initial` that doesn't actually hide anything must not leave a button
   standing that reveals nothing. */
const deferredFrom = initial != null && initial < items.length ? initial : items.length;
const hasDeferred = deferredFrom < items.length;

/* Written out rather than interpolated — `sm:grid-cols-${columns}` is invisible
   to Tailwind's scanner, which reads source text and never runs this file, so
   the class would simply not be generated. Two entries because two is what the
   grid supports; a fourth column is not a lookup-table edit, it is the
   card-shrinks-past-legibility problem in the note below. */
const columnClass = columns === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2';
---

{/* Two columns from sm up, three when the caller asks (see the `columns` prop).
    The gaps are uneven on purpose: the column gap only has to separate two
    cards side by side, while the row gap also has to out-space the gap INSIDE a
    card (title → image), or a card's image reads as belonging to the title
    below it.

    ⚠ THE COLUMN GAP IS LOAD-BEARING AT ANY COLUMN COUNT and does not change
    with it: each card's p-3/-m-3 pair reaches 0.75rem past its track on both
    sides, and gap-x-6 (1.5rem) is exactly two of those, so neighbouring hover
    panels meet and never overlap. Three columns adds a second such meeting
    point rather than tightening the existing one, so the arithmetic carries
    over untouched — but it is the reason narrowing the gutter to buy card width
    is not available as a fix (ProjectCard.astro says the same from its end).

    What three columns DOES cost is card width: inside the 960px page (912.5px
    of content, since px-5 is 1.25rem and the root is 19px) a 2-up track is
    442px and a 3-up track is 285.17px, a 35% cut. The card takes that cut in
    the TITLE, which is the only part of it that reflows — the frame is
    aspect-[16/9] so it just gets shorter in proportion, and the year is four
    characters wide at any track. So the column count is really a question about
    the longest title on the site, which is currently migaki's at 38 characters,
    and a fourth column is where that stops being arguable: 206.75px tracks
    against a title that already needs two lines at 285px, with the text block
    growing every time the image it labels shrinks. Three is the ceiling until
    ProjectCard gets a smaller title of its own.

    ⚠ EVERY px FIGURE ON THIS PAGE IS AT A 19px ROOT, which is what this site
    runs (it is why the body text is 16.625px and not 16). Tailwind's scale is
    in rem, so a 16px-root reading of the same class names gives 920/448/290.67
    — all wrong, and wrong by little enough to look right. Multiply by 19/16. */}
{/* The grid reveals as ONE block on the home page, --i 1 behind the hero
    (2026-08-06, Hiro) — the per-card stagger (each card in its own .reveal
    wrapper, --i index + 2) came out with the hero's collapse to a single
    entry. There the reveal sits on #project-list rather than #projects so the
    section's rule (#projects::before) stays OUTSIDE the reveal: it is
    page-level structure and enters in the hairline finale, not with the
    content — see the finale block in global.css.

    The cards are direct grid children. Their p-3/-m-3 pair behaves identically
    as a grid item (the negative margin grows the card past its track by the
    same 0.75rem the wrapper let it overflow), and the panel script's offset
    walk simply has one less hop — it accumulates the offsetParent chain, so it
    never cared how many wrappers sat in between (see the note on offsetIn
    below). */}
<div
	id="project-list"
	class:list={['grid grid-cols-1 gap-x-6 gap-y-10', columnClass, className]}
	style={style}
>
	{/* The hover panel — one for the whole grid, sliding to whichever card is
	    hovered or focused. MUST STAY FIRST: it's kept under the cards by DOM
	    order as well as z-index (see .card-panel in global.css). Absolutely
	    positioned, so it claims no grid track. */}
	<div class="card-panel" aria-hidden="true"></div>
	{items.map((project, i) => (
		<ProjectCard project={project} deferred={i >= deferredFrom} />
	))}
	{/* ── The toggle: "Show more" / "Show less" ──
	    ONE BUTTON, NOT TWO. It was a one-shot that removed itself until Hiro
	    asked for a show-less (2026-08-15); a second control below the expanded
	    grid would have been a second thing in the same place doing the inverse
	    job, and the visitor would have watched one swap for the other. A toggle
	    is what a disclosure is. The label text is the state — "Show less" can
	    only mean the list is open — which is also why there is no aria-expanded
	    here: the accessible NAME already carries it, and aria-controls would
	    have to point at this button's own ancestor, which is not what that
	    attribute means.

	    Both strings live in data- attributes rather than in the script, so the
	    words stay in the markup with the rest of the copy and the script only
	    picks between them. The rendered label is the collapsed one, because
	    that is the state the page opens in.

	    A GRID ITEM, spanning every column, and that is the load-bearing part:
	    the home page's .reveal sits on #project-list, so a button placed
	    outside it would be the one thing on the page already at rest while the
	    cards are still at opacity 0 — visible for the whole 0.8s cascade,
	    announcing a list that hasn't arrived. Inside, it enters with the block
	    it belongs to and the caller keeps owning the reveal (see Props).

	    It also means the row gap positions it: gap-y-10 against a card whose
	    -m-3 pulls its painted edge 0.75rem down, so the button sits 1.75rem
	    under the last panel edge and 2.5rem under the last image. Nothing else
	    is needed, and adding a margin here would put the control at a distance
	    the grid's own rhythm didn't choose.

	    CENTRED, not on the column's left edge. The page has a strong left edge
	    — the wordmark, the leftmost year, the rule, the copyright all land on
	    it — and this deliberately doesn't join it: the control belongs to the
	    whole grid rather than to its first column, the way the hero's button
	    belongs to the hero. justify-self is a one-word change if that reads
	    wrong once there are more than five projects.

	    NO `hidden` ATTRIBUTE, and this is not a style preference: global.css is
	    unlayered while Tailwind's preflight (which is what defines
	    `[hidden] { display: none }`) sits in @layer base, so ANY unlayered class
	    rule here beats it and the attribute would simply not hide the button.
	    The visibility runs through .projects-more instead, which is display:none
	    until .is-enhanced says otherwise — the same switch, in the one place
	    that can actually hold it. */}
	{hasDeferred && (
		<button
			type="button"
			class="btn-quiet btn-quiet--down projects-more col-span-full justify-self-center"
			data-label-more="Show more"
			data-label-less="Show less"
		>
			<span class="btn-quiet__label">Show more</span>
			{/* The hero's arrow turned a quarter: same 24-unit box, same line +
			    polyline, pointing at what it will reveal instead of where it
			    will take you. Sized to .contact-caret's 0.85rem, the bar's
			    figure for a glyph beside 0.875rem text.
			    It is drawn pointing DOWN in both states and turned over by CSS
			    when the grid is open — see the rotate rule in global.css for why
			    a rotation rather than a second set of points. That turn is the
			    only thing the glyph does: it had a hover nudge until
			    2026-08-16, when Hiro asked for the movement to come off. */}
			<svg
				class="btn-quiet__arrow"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
				width="14"
				height="14"
			>
				<line x1="12" y1="4" x2="12" y2="19"></line>
				<polyline points="5 12 12 19 19 12"></polyline>
			</svg>
		</button>
	)}
</div>

{/* ── The opening state, set PRE-PAINT ──
    is:inline and placed immediately after the grid, so it executes while the
    parser is still on this page and before the first frame is painted. A
    module <script> (what Astro compiles a bare <script> to) is deferred until
    after the document parses, which is one or more painted frames later — the
    visitor would see all five cards, then watch one vanish.

    It is also why both states are CLASSES added by script rather than the
    default in the CSS: the markup's resting state is the full list, so anything
    that fails to run — JS off, a blocked bundle, a syntax error in a browser
    this doesn't parse — leaves every project on the page and draws no button.
    .is-enhanced is the flag for "a script is driving this"; .is-collapsed is
    the state it happens to be in. The button hangs off the first, the cards off
    the second, which is what lets the toggle stand in both (global.css has the
    full note).

    The hash guard: a link to a card that happens to sit past the initial run
    (#project-shipyard) would otherwise land on a display:none element and
    scroll nowhere. Nothing on the site writes such a link today — the nav's
    per-card landing was removed on 2026-08-18, see Nav.astro — but a
    visitor's bookmark or a shared URL is outside our control, and the whole
    feature is one line cheaper to make correct than to explain. When it fires,
    the page opens EXPANDED, so the label has to open as "Show less" — and it
    has to be written here rather than in the module script below, or the
    button paints with the wrong word on it for a frame or two. */}
<script is:inline>
	(function () {
		var list = document.getElementById('project-list');
		var btn = list && list.querySelector('.projects-more');
		if (!btn) return;
		list.classList.add('is-enhanced');
		// try/catch, not a regex on the hash: '#' alone and any hash a visitor
		// can type are legal in a URL and illegal in a selector, and a throw
		// here would abort the collapse and leave the button drawn over an
		// already-full list. A bad hash simply isn't one of our cards.
		var target = null;
		try {
			if (location.hash.length > 1) {
				target = list.querySelector(location.hash + '.project-card--deferred');
			}
		} catch (e) {}
		if (target) {
			btn.querySelector('.btn-quiet__label').textContent = btn.dataset.labelLess;
		} else {
			list.classList.add('is-collapsed');
		}
	})();
</script>

{/* ── The travelling hover panel ──
    Drives .card-panel to whichever card is hovered or focused. Built on the
    same shape as the nav's contact pill (Nav.astro): a shared element that
    SLIDES between targets when one is already showing, and snaps into place
    with transitions suppressed when it first appears — otherwise the entrance
    animates from wherever the last card left it, or from 0,0 on the first
    hover, which reads as the panel flying in from the corner.

    All geometry comes from offsetLeft/Top/Width/Height, never
    getBoundingClientRect: offset values are the UNTRANSFORMED layout box. This
    mattered more when the card lifted 3px on hover — a rect read mid-transition
    had the panel chasing a moving target — and the card is still scaled while
    pressed, so the reason hasn't fully gone away. Keep it regardless: a panel
    that measures its target's transform will always be one gesture behind.

    But they must be ACCUMULATED up the offsetParent chain, not read once — see
    offsetIn below. Since the grid became the reveal element (2026-08-06) the
    chain is a single hop on the home page — a card's offsetParent is
    #project-list itself — so the walk is momentarily equivalent to reading
    offsetLeft/Top directly. Keep the walk anyway: it's what made the per-card
    .reveal wrappers harmless (each ran a filling transform animation, and an
    element with a filling transform animation is a containing block FOREVER,
    so every card reported its own -12,-12 negative margin instead of a grid
    position — the panel never left the first card until the chain was
    accumulated), and it keeps any future wrapper from silently reintroducing
    that bug. The project page's strip is exactly that case: its grid sits
    inside a .reveal <section>, so the chain there is longer than one hop and
    the walk is doing real work again. */}
<script>
	const list = document.getElementById('project-list');
	const panel = list?.querySelector<HTMLElement>('.card-panel');

	if (list && panel) {
		const cards = Array.from(list.querySelectorAll<HTMLElement>('.project-card'));
		// The card no longer lifts on hover (2026-08-02), so the panel simply lands
		// on the card's own box. This used to read a --card-lift property off the
		// list and subtract it here, with a reduced-motion branch because the lift
		// was pinned to 0 under that setting and the two had to agree. All of it
		// came out with the lift; see the note in global.css if one comes back.
		let visible = false;
		let current: HTMLElement | null = null;
		// Where place() last put the panel's top-left corner, in list coordinates.
		// Read only to work out which way the NEXT hop travels; the panel's own
		// style.left/top would do as a source but would have to be parsed back out
		// of a string, and a computed read mid-transition reports an interpolated
		// value rather than the target the last hop was aimed at.
		let placed = { x: 0, y: 0 };

		// Sum offsetLeft/Top from `el` up to (not including) `root`, following the
		// offsetParent chain rather than the DOM parent chain. Terminates on the
		// root because #project-list is position: relative, so it is the first
		// positioned ancestor any chain from inside the grid can reach; the null
		// check is a guard against that ever changing silently.
		const offsetIn = (el: HTMLElement, root: HTMLElement) => {
			let x = 0;
			let y = 0;
			let node: HTMLElement | null = el;
			while (node && node !== root) {
				x += node.offsetLeft;
				y += node.offsetTop;
				node = node.offsetParent as HTMLElement | null;
			}
			return { x, y };
		};

		// Written as FOUR EDGES, not a translate plus a size (2026-10-11, the
		// stretch): each edge has to be its own property so each can run on its
		// own clock — see the --panel-lead/--panel-trail note on #project-list.
		// right and bottom are calc(100% - …) against the list, so a list that
		// changes size under a resting panel doesn't drag those edges with it.
		//
		// The jiggle that put the position on `translate` (08-05: a position on
		// `transform` sat inside the press's scale and got multiplied by it)
		// can't recur here — insets are layout, not a transform, so the press
		// scales the box where it stands.
		const place = (card: HTMLElement) => {
			const { x, y } = offsetIn(card, list);
			panel.style.left = `${x}px`;
			panel.style.top = `${y}px`;
			panel.style.right = `calc(100% - ${x + card.offsetWidth}px)`;
			panel.style.bottom = `calc(100% - ${y + card.offsetHeight}px)`;
			return { x, y };
		};

		// Which way this hop goes, one axis at a time, as the attributes the CSS
		// reads to give the TRAILING edge of each moving axis the slower clock.
		// An axis with no travel gets no attribute: both its edges lead, and a
		// difference in card height on that axis simply resizes in step.
		const aim = (from: { x: number; y: number }, to: { x: number; y: number }) => {
			panel.dataset.x = to.x > from.x ? 'right' : to.x < from.x ? 'left' : '';
			panel.dataset.y = to.y > from.y ? 'down' : to.y < from.y ? 'up' : '';
		};

		const show = (card: HTMLElement) => {
			// Already on this card: do nothing. Pressing a card hits this every
			// time — mousedown focuses the card's <a>, and focusin calls show()
			// with the card already showing. It used to matter more (it restarted
			// the travelling compress under the press, which was most of the
			// 08-05 jiggle); now it just saves re-aiming a panel that isn't going
			// anywhere.
			if (visible && card === current) return;
			current = card;
			if (visible) {
				// Stretch to the new card. The direction goes on in the SAME style
				// change as the new edges — a transition takes its timing from the
				// style it is moving to, so the trailing edges pick up their slower
				// clock for this hop without a reflow in between. A hop that cuts
				// into one still in flight just re-aims from wherever each edge is.
				const from = placed;
				placed = offsetIn(card, list);
				aim(from, placed);
				place(card);
				return;
			}
			// First appearance: kill the transition, land on the card, force the
			// reflow so the browser doesn't coalesce the two states, then let the
			// class fade it up. Only opacity animates here: the panel is being
			// placed, not moved.
			panel.style.transition = 'none';
			placed = place(card);
			void panel.offsetWidth;
			panel.style.transition = '';
			panel.classList.add('is-visible');
			visible = true;
		};

		const hide = () => {
			visible = false;
			current = null;
			panel.classList.remove('is-visible');
		};

		// Crossing the gutter between two cards briefly leaves every card, which
		// would hide the panel and re-show it at the new one — killing the slide
		// that is the whole point. A short grace delay lets the next enter cancel
		// the hide, so a sweep across the grid stays one continuous move; pausing
		// in the gutter still clears it.
		let gapHideTimer = 0;
		cards.forEach((card) => {
			card.addEventListener('mouseenter', () => {
				window.clearTimeout(gapHideTimer);
				show(card);
			});
			card.addEventListener('mouseleave', () => {
				window.clearTimeout(gapHideTimer);
				gapHideTimer = window.setTimeout(hide, 90);
			});
		});
		list.addEventListener('mouseleave', () => {
			window.clearTimeout(gapHideTimer);
			hide();
		});

		// Keyboard: the panel follows focus too, so tabbing through the grid marks
		// the same card the underline and the lift do.
		//
		// The `else` is for "Show more", which is the first thing inside this list
		// that can take focus without being a card. Without it, tabbing off the
		// last card onto the button leaves the panel lit under a card nothing is
		// pointing at any more — focusout won't fire the hide either, since focus
		// never left the list. It was a no-op before that button existed.
		list.addEventListener('focusin', (e) => {
			const card = (e.target as HTMLElement).closest<HTMLElement>('.project-card');
			if (card) show(card);
			else hide();
		});
		list.addEventListener('focusout', (e) => {
			if (!list.contains(e.relatedTarget as Node)) hide();
		});

		// The grid reflows on resize (one column below sm), so every offset the
		// panel is holding goes stale. Re-place rather than hide — the pointer may
		// still be over the same card — and do it with transitions off, since the
		// panel isn't travelling anywhere, it's being corrected.
		window.addEventListener('resize', () => {
			if (!visible || !current) return;
			panel.style.transition = 'none';
			// Kept in step or the next hop reads its direction against a column
			// position that no longer exists — crossing the sm breakpoint moves
			// every card to x=0, and a stale `placed` would call that a leftward
			// hop and trail the wrong edge.
			placed = place(current);
			void panel.offsetWidth;
			panel.style.transition = '';
		});
	}
</script>

{/* ── The toggle ──
    One class on or off the list is the whole state change; the label and the
    arrow follow from it (the arrow entirely in CSS — see the rotate rule in
    global.css).

    THE CARDS DO NOT ANIMATE, in either direction, deliberately. The site's
    entrance rule is one cascade on arrival and static thereafter (see the
    reveal block in global.css and the carve-out it records); a card fading up
    in the middle of a settled page would be the only element on the site that
    enters twice.

    A separate script from the panel's above because it is a separate concern
    and must run whether or not the panel bound — the panel's whole block sits
    behind `if (list && panel)`, and a grid that somehow lost its panel should
    still open rather than strand the visitor with four projects. */}
<script>
	const moreList = document.getElementById('project-list');
	const moreBtn = moreList?.querySelector<HTMLButtonElement>('.projects-more');
	const moreLabel = moreBtn?.querySelector<HTMLElement>('.btn-quiet__label');

	if (moreList && moreBtn && moreLabel) {
		moreBtn.addEventListener('click', () => {
			const collapsing = !moreList.classList.contains('is-collapsed');
			// Read before anything moves — see the focus note below.
			const byKeyboard = moreBtn.matches(':focus-visible');
			const before = moreBtn.getBoundingClientRect().top;

			moreList.classList.toggle('is-collapsed', collapsing);
			moreLabel.textContent = collapsing ? moreBtn.dataset.labelMore! : moreBtn.dataset.labelLess!;

			// ── The scroll correction is for COLLAPSE ONLY, and the asymmetry is
			//    the whole point rather than an omission ──
			// The cards sit ABOVE the button, so the two directions do opposite
			// things to it. EXPANDING pushes it down by a card's height and the
			// new row lands exactly where the button just was — which is the best
			// possible outcome, because that is where the visitor is looking.
			// Correcting for it would scroll the page down to chase the button and
			// drag the new row straight back out of view, so expand is left alone.
			// COLLAPSING is the mirror: the button jumps UP a card's height, out
			// from under the cursor that just pressed it, and if the page was near
			// its end the shortened document clamps the scroll on top of that.
			// Anchoring turns it into what it should be — the list folds away and
			// the control stays put.
			//
			// getBoundingClientRect, not offsetTop, precisely because the viewport
			// is the frame of reference here rather than the document; reading it
			// after the class change also means any clamping is already in the
			// number. The two-argument scrollBy is always instant — this is a
			// correction, not a journey, and a smooth one would read as the page
			// sliding on its own. Native scroll anchoring is deliberately not
			// relied on: it chooses its own anchor and engines disagree about
			// changes above the viewport.
			if (collapsing) {
				const delta = moreBtn.getBoundingClientRect().top - before;
				if (delta) window.scrollBy(0, delta);
			}

			// On EXPAND, hand focus to the first card that just appeared. The
			// revealed cards sit BEFORE the button in the DOM, so a keyboard
			// visitor who kept focus on the toggle would have to walk backwards to
			// reach what they asked for, and a screen reader would be told nothing
			// arrived at all. Landing on the card puts the next Tab back on the
			// toggle — now reading "Show less" — which is the order you want.
			//
			// Guarded on :focus-visible so a POINTER click doesn't do the same: a
			// mouse visitor is already looking at the row that appeared, and
			// focusing a card there would light the hover panel under a card their
			// cursor is nowhere near.
			//
			// Nothing to do on COLLAPSE: the button is still here and still has
			// focus, and it is the right place to be — the thing that changed is
			// that the list it controls got shorter.
			if (!collapsing && byKeyboard) {
				moreList.querySelector<HTMLElement>('.project-card--deferred')?.focus();
			}
		});
	}
</script>

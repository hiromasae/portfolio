---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Hiro Eernisse — Design Engineer',
	description = 'Portfolio of Hiro Eernisse, a design engineer in the SF Bay Area — product UI, design systems, and the work behind them.',
} = Astro.props;
---

<!doctype html>
{/* data-theme is stamped in the MARKUP, not by the script below, so the site's
    default survives with JS disabled or still parsing. Dark is that default. */}
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		{/* Resolve the theme before first paint so there's no flash of the wrong
		    mode. Only an explicit saved choice can move it off dark; the OS
		    preference is deliberately NOT consulted, so a visitor on a light
		    desktop still lands on dark and the nav toggle is the way out. If
		    that ever needs to go back to following the OS, the condition is the
		    only thing to change — the attribute above stays as the fallback. */}
		<script is:inline>
			(function () {
				try {
					if (localStorage.getItem('theme') === 'light') {
						document.documentElement.dataset.theme = 'light';
					}
					/* The bar preference rides the same pre-paint stamp: sticky is
					   the default, and only the explicit saved choice moves off it —
					   resolved here so the bar never paints sticky and then unpins
					   (or vice versa) after first paint. Flipped from the settings
					   menu in Nav.astro; the CSS side is the data-nav-static rule
					   over #site-nav in global.css. */
					if (localStorage.getItem('nav-sticky') === 'off') {
						document.documentElement.dataset.navStatic = '';
					}
				} catch (e) {}
			})();
		</script>
		{/* Critical hide for the content reveal — global.css drives the actual
		    animation and holds. Lives here so it's present before first paint on
		    every page, and left untouched by Vite's dev HMR style swap (which
		    briefly drops the global rules and would flash the content). */}
		<style is:inline>
			.reveal {
				opacity: 0;
			}
			html.reveal-skip .reveal,
			html.projects-landing .reveal {
				opacity: 1;
			}
			/* Held with the nav's load intro while the webfonts settle (see
			   whenTypeSettled in Nav.astro). Paused, not re-delayed: the holds
			   in global.css are tuned against the intro's fixed delays, so
			   pausing shifts the whole cascade intact — and pausing catches the
			   delay phase too, which is where this always lands. Here rather
			   than in global.css so an HMR style swap can't drop it and let the
			   content march off without the bar. */
			html.reveal-wait .reveal {
				animation-play-state: paused;
			}
			@media (prefers-reduced-motion: reduce) {
				.reveal {
					opacity: 1;
				}
			}
		</style>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<!-- Recursive from Google Fonts — the site's only face, replacing Archivo
		     (2026-08-03). A variable face, so the whole 300–700 range comes from
		     one file, as a RANGE rather than four pinned stops: Recursive's wght
		     runs 300–1000 continuously and there is no reason to quantise it.

		     The floor is 300, Recursive's lightest, because the site's weight
		     scale was moved DOWN a step on 2026-08-04 (Hiro: "much lighter") and
		     body text now sits at 300 — see the scale in global.css's body rule.
		     The ceiling stays 700 even though nothing currently asks above 500:
		     on a variable face a wider range costs essentially nothing, and it
		     means every weight the CSS can name is one the file really has. That
		     is the lesson the .btn comment in global.css was written to record —
		     a declared weight the font lacks gets synthesised or snapped, and
		     under a webfont swap the two sides disagree visibly.

		     The four other axes are PINNED IN THE URL, which is what makes this
		     "Recursive Sans" and not the whole superfamily — Google instances the
		     file at those values and ships one static-on-those-axes, variable-on-
		     wght woff2, so the pinning costs nothing and can't drift:
		       MONO 0  proportional sans, not the monospace end (this is the axis
		               that makes it "Sans"; MONO 1 is Recursive Mono)
		       CASL 0  Linear, the neutral drawing, not the Casual/handwritten one
		       slnt 0  upright; nothing on the site sets italic
		       CRSV 0  roman letterforms. The face's own default is 0.5 ("auto",
		               cursive only when slanted) — harmless here since slnt is
		               pinned upright, but 0 states it rather than relying on how
		               auto resolves.
		     Axis order in the URL is not free: the css2 API wants registered
		     (lowercase) axes alphabetically, then custom (uppercase) ones, and
		     rejects any other order. -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Recursive:slnt,wght,CASL,CRSV,MONO@0,300..700,0,0,0&display=swap"
		/>
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

---
import { Font } from 'astro:assets';

import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Hiro Eernisse — Design Engineer',
	description = 'Portfolio of Hiro Eernisse, a design engineer in the SF Bay Area — product UI, design systems, and the work behind them.',
} = Astro.props;

// Every page canonicalises to ITSELF, absolute, off `site` in
// astro.config.mjs. Both halves matter and for different reasons: the URL has
// to be absolute because og:url and rel=canonical are the two tags a relative
// path is simply invalid in — a crawler resolves them against nothing — and it
// has to be self-referencing because the alternative, pointing every page at
// the home page, tells the index the project pages don't exist.
//
// Astro.url.pathname, not a hand-passed prop: this layout wraps every route,
// including the [slug] project pages, and a prop would be one more thing each
// page has to remember to get right. Derived once here and used by the
// canonical link, og:url, and nothing else — if a third consumer appears it
// still reads this, not its own new URL().
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
{/* data-theme is stamped in the MARKUP, not by the script below, so the site's
    default survives with JS disabled or still parsing. Dark is that default. */}
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		{/* Type, FIRST in the head and ahead of even the favicon — this emits
		    the @font-face (pointing at our own origin) and a
		    <link rel="preload"> for the woff2, and a preload is only worth
		    having if the parser reaches it early. Everything below it is
		    inline and parses in the same breath, so the fetch is effectively
		    kicked off with the HTML itself rather than after a stylesheet
		    round-trip — which is the whole point of the move off the Google
		    Fonts CDN. The face, its axis pinning, and why it is self-hosted
		    are documented at the `fonts` block in astro.config.mjs; the CSS
		    variable it defines is consumed by --font-sans in global.css. */}
		<Font cssVariable="--font-recursive" preload />
		{/* Two marks, one per mode — the dark one (pale green on near-black) is
		    the default, matching data-theme above, so the tab is already right
		    with JS off. The pair CANNOT be hung off `media="(prefers-color-
		    scheme: …)"` link tags the way the usual recipe does: this site's
		    mode is its own, stored in localStorage and defaulting to dark
		    regardless of the OS (see the script below), so the OS query would
		    disagree with the page on every visitor who hasn't matched their
		    desktop to it. The href is driven from data-theme instead — resolved
		    pre-paint here, re-synced by the nav toggle. Declared ahead of that
		    script because the script reaches for this element by id. */}
		<link rel="icon" id="favicon" type="image/svg+xml" href="/hirofavicondark.svg" />
		{/* Resolve the theme before first paint so there's no flash of the wrong
		    mode. Only an explicit saved choice can move it off dark; the OS
		    preference is deliberately NOT consulted, so a visitor on a light
		    desktop still lands on dark and the nav toggle is the way out. If
		    that ever needs to go back to following the OS, the condition is the
		    only thing to change — the attribute above stays as the fallback. */}
		<script is:inline>
			(function () {
				// Exposed globally because the nav's toggle needs it too, and that
				// script is a module bundled separately from this inline one.
				window.__syncFavicon = function (theme) {
					var href = theme === 'light' ? '/hirofaviconlight.svg' : '/hirofavicondark.svg';
					var link = document.getElementById('favicon');
					// Skipping the no-op write matters: re-setting href to the value
					// it already holds makes some browsers drop and refetch the icon,
					// which reads as a flicker in the tab on every unrelated call.
					if (link && link.getAttribute('href') !== href) link.setAttribute('href', href);
				};
				// Named and re-runnable because a bfcache restore doesn't re-run this
				// script: the page comes back with whatever data-theme and favicon it
				// had when it was left, which is stale if the toggle was hit on
				// another page since. Writes both branches, not just light — a
				// restored page can be sitting on light with 'dark' saved.
				window.__applyTheme = function () {
					var theme = 'dark';
					try {
						if (localStorage.getItem('theme') === 'light') theme = 'light';
					} catch (e) {}
					document.documentElement.dataset.theme = theme;
					window.__syncFavicon(theme);
				};
				window.__applyTheme();
				window.addEventListener('pageshow', function (event) {
					if (event.persisted) window.__applyTheme();
				});
			})();
		</script>
		{/* Critical hide for the content reveal — global.css drives the actual
		    animation and holds. Lives here so it's present before first paint on
		    every page, and left untouched by Vite's dev HMR style swap (which
		    briefly drops the global rules and would flash the content). */}
		<style is:inline>
			.reveal {
				opacity: 0;
			}
			/* Held on a hard load while the webfonts settle, so nothing slides
			   in wearing the fallback face (see whenTypeSettled in Nav.astro).
			   Paused, not re-delayed: pausing shifts the cascade intact where
			   rewriting animation-delay mid-flight would restart it — and it
			   catches the delay phase too, which is where this always lands.
			   Here rather than in global.css so an HMR style swap can't drop it
			   and let the content march off before its type arrives. */
			html.reveal-wait .reveal {
				animation-play-state: paused;
			}
			@media (prefers-reduced-motion: reduce) {
				.reveal {
					opacity: 1;
				}
			}
		</style>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		{/* ── The shared card (2026-08-18) ──
		    Everything below is driven by the SAME two props as <title> and the
		    description above, deliberately: a page that has bothered to write a
		    good title has already written the card's headline, and letting the
		    two drift is how a site ends up posting one thing to a search result
		    and another to a chat window. There is no separate ogTitle prop for
		    that reason — if a page ever genuinely needs to say something
		    different when shared, add it then and let this fall back to title,
		    rather than carrying an unused knob now. */}
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Hiro Eernisse" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{/* The card image. 1200×630, dark (the site's default theme), and
		    GENERATED rather than exported by hand: scripts/og-card.html is the
		    artwork, and `node scripts/render-og.mjs` renders it to public/og.png
		    painting it in the dark theme's own tokens, read out of global.css at
		    render time. Re-run that after moving the <h1> in src/pages/index.astro
		    or any of the tokens it lists. The PNG is committed, so the build needs
		    neither the script nor a browser.

		    THE INDIRECTION IS THE POINT, and it is the lesson of what this
		    replaces. Until 2026-09-02 this spot held a comment explaining why there
		    was NO image: the only candidate, legacy/og-image.png, was a screenshot
		    of the PREVIOUS site — navy gradient and an orange pill button where
		    this one is paper and green, over a headline that appears nowhere in
		    src/ any more, with the browser scrollbar still down its right edge.
		    Shipping it would have put a picture of a site that no longer exists at
		    the top of every link to this one, and a card that LOOKS wrong is worse
		    than a card that is merely plain — the reader trusts the image over the
		    text and arrives expecting the other site. That argument stands. What
		    changed is only that the card is now DERIVED from the site rather than
		    photographed off it, so it cannot rot the same way.

		    Absolute off Astro.site, the same reason canonical is: og:image is one
		    of the handful of tags a relative path is simply invalid in. */}
		<meta property="og:image" content={new URL('/og.png', Astro.site)} />
		{/* Declared because a scraper that isn't told the size reserves a
		    placeholder at the wrong aspect and pops when the real file lands. Keep
		    these in step with WIDTH/HEIGHT in scripts/render-og.mjs, which is
		    where the render actually gets its dimensions. */}
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		{/* Describes the IMAGE, not the page. The description above already says
		    what the site is, and repeating it here would tell a reader who can't
		    see the card nothing about what they are actually missing. */}
		<meta property="og:image:alt" content="The HE monogram over a rule, above the line “Design engineering, with good sense and taste.”" />
		{/* summary_large_image, now that there IS an image to build the frame
		    around. It was plain `summary` until 2026-09-02 precisely because there
		    wasn't one: the large card is a frame around a picture, and asking for
		    one without supplying it is how you get the stretched blank panel with
		    the text crushed underneath. Twitter reads the og: tags above for title,
		    description and url, so those still aren't repeated here — only the one
		    thing it has no Open Graph equivalent for. */}
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<slot />
	</body>
</html>

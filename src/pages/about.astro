---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="About — Hiro Eernisse" description="About Hiro Eernisse, product design engineer.">
	<Nav />

	<main class="mx-auto max-w-[1280px] px-5 py-12 sm:py-16">
		<div class="max-w-xl space-y-4 text-lg leading-relaxed">
			<p class="mb-10 text-2xl font-bold tracking-tight text-[var(--ink)] sm:text-3xl">はじめまして。</p>
			<p>I'm a Design Engineer based in the San Francisco Bay Area.</p>
			<p>
				In an era of AI-generated slop, I care deeply about polish, intentional user flows, and
				interfaces that feel original.
			</p>
			<p>Outside of work, I play heavy metal drums.</p>
		</div>
	</main>
</Layout>

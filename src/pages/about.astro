---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="About — Hiro Eernisse" description="About Hiro Eernisse, design engineer.">
	<Nav />

	<main class="mx-auto max-w-[960px] px-5 py-12 sm:py-16">
		{/* Stacked, not side by side. It was prose-beside-photo until 08-02, when
		    the page came in to 960px: the figure held 26rem of that, which left
		    the prose ~346px and about FIVE words a line against a 10–12 target.
		    There is no breakpoint that rescues it — the container is capped below
		    the width the two-column version needs, so the row would never get its
		    room back. Stacking gives the prose the full measure and costs only
		    the composition, which was the weaker reason of the two. */}
		<div class="flex flex-col gap-12">
			<div class="max-w-[var(--measure)] space-y-6 text-lg leading-relaxed">
				<h1 class="reveal mb-12 text-3xl font-bold tracking-tight text-[var(--ink)] sm:text-4xl" style="--i: 0">はじめまして。</h1>
				<p class="reveal" style="--base: 700ms; --i: 0">I'm a Design Engineer based in the San Francisco Bay Area.</p>
				<p class="reveal" style="--base: 700ms; --i: 1">
					I build with AI, but I make the decisions that matter myself. Taste, and knowing how a
					person moves through a product, is still human work.
				</p>
				<p class="reveal" style="--base: 700ms; --i: 2">Outside of work, I play heavy metal drums and hike.</p>
			</div>
			{/* The lg overrides came off with the row — 26rem was sized to hold its
			    half of a two-column page, and stacked it would just be a large
			    photo. Capped at the measure instead, so its edges line up with the
			    prose above it. */}
			<figure class="reveal w-full max-w-[18rem] sm:max-w-[22rem]" style="--base: 180ms; --i: 0">
				<img
					src="/images/me.webp"
					alt="Hiro Eernisse"
					width="832"
					height="1040"
					class="aspect-[4/5] w-full rounded-[1.5px] border border-[var(--line)] object-cover"
				/>
				<figcaption class="mt-2.5 flex items-center gap-1.5 text-xs text-[var(--ink-soft)]">
					<svg
						class="h-3.5 w-3.5 shrink-0"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="square"
						stroke-linejoin="miter"
						aria-hidden="true"
					>
						<path d="M12 22s7-6.5 7-12a7 7 0 0 0-14 0c0 5.5 7 12 7 12Z" />
						<circle cx="12" cy="10" r="2.5" />
					</svg>
					Eagle Lake, South Lake Tahoe, CA
				</figcaption>
			</figure>
		</div>
	</main>
</Layout>

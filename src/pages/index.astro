---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<Layout>
	<Nav />

	<main class="mx-auto max-w-[960px] px-5">
		{/* Hero. The masthead above already carries the name at full size, so this
		    says what the name does and hands off to About — the page's only route
		    there since the nav links came out (2026-08-01). Held to --measure and
		    the about page's own opening line, in its type size, so arriving from
		    either direction reads as one voice. */}
		<section class="pt-10 pb-14 sm:pt-12">
			<p class="reveal max-w-[var(--measure)] text-lg leading-relaxed" style="--i: 0">
				I'm a Design Engineer based in the San Francisco Bay Area.
			</p>
			{/* Same wipe-in underline and tilting arrow as a project card title, so
			    the site has one "this goes somewhere" gesture — but with the arrow
			    drawn at rest, since here it's the affordance and not a flourish
			    (see .hero-link in global.css). */}
			<p class="reveal mt-4" style="--i: 1">
				<a href="/about" class="hero-link group text-lg text-[var(--ink-soft)]">
					<span class="hero-link__text">About</span>
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
						class="hero-link__arrow ml-2 inline-block h-[1.05rem] w-[1.05rem] align-[-0.125em]"
					>
						<line x1="4" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</a>
			</p>
		</section>

		{/* Projects */}
		<section id="projects" class="scroll-mt-20 pb-16">
			{/* Two columns from sm up. The gaps are uneven on purpose: the column
			    gap only has to separate two cards side by side, while the row gap
			    also has to out-space the gap INSIDE a card (title → image), or a
			    card's image reads as belonging to the title below it. */}
			<div id="project-list" class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2">
				{/* +2: the hero's two lines hold --i 0 and 1, so the whole page reveals
				    as one top-down cascade instead of the first cards arriving
				    alongside the hero. */}
				{projects.map((project, index) => (
					<div class="reveal" style={`--i: ${index + 2}`}>
						<ProjectCard project={project} />
					</div>
				))}
			</div>
		</section>
	</main>

	<footer class="mx-auto max-w-[960px] px-5 py-10 text-sm text-[var(--ink-soft)]">
		<span>© 2026 Hiro Eernisse</span>
	</footer>

</Layout>

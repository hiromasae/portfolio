---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<Layout>
	<Nav />

	<main class="mx-auto max-w-[1280px] px-5">
		<!-- Projects -->
		<section id="projects" class="scroll-mt-20 pt-10 pb-16 sm:pt-12">
			<div id="project-list" class="flex flex-col gap-12">
				{projects.map((project, index) => (
					<div class="reveal" style={`--i: ${index}`}>
						<ProjectCard project={project} />
					</div>
				))}
			</div>
		</section>
	</main>

	<footer class="mx-auto max-w-[1280px] px-5 py-10 text-sm text-[var(--ink-soft)]">
		<span>© 2026 Hiro Eernisse</span>
	</footer>

</Layout>

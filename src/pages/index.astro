---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<Layout>
	<Nav />

	<main class="mx-auto max-w-[960px] px-5">
		{/* Hero. The masthead above already carries the name at full size, so this
		    says what the name does and hands off to About — the page's only route
		    there since the nav links came out (2026-08-01). Held to --measure so a
		    wide viewport can't run the line out past a readable length.

		    It used to be the about page's opening line verbatim, matched to its
		    type size so arriving from either direction read as one voice. That
		    stopped being true when this line became its own sentence: the two
		    pages now open differently on purpose, the home page saying what the
		    work IS and About saying who does it. The size match went with it —
		    about-page had followed About's 08-02 step down to the base 19px on
		    THIS line too, and that change was dropped when the two branches were
		    merged, since there is no longer a shared sentence to keep in step.
		    If the two are ever written the same again, re-match the size. */}
		{/* Centred, both lines, each on its own axis (2026-08-02, Hiro). This
		    REPLACES the shared-left-edge lockup from earlier the same day, and the
		    reason it can: that arrangement existed because the second line was a
		    bare text link that had to read as hanging off the sentence, which a
		    second centring axis would have broken. It's a button now — a boxed
		    control is self-evidently its own object, so it doesn't need the
		    sentence's left edge to say so, and the hero reads as one deliberate
		    centred block instead. */}
		{/* Padding stepped up one full stop 2026-08-03 (Hiro: let the hero breathe
		    more) — 64/80 → 96/112, and 80/96 → 112/128 from sm up. The 1rem
		    top/bottom ASYMMETRY is deliberate and survives the increase: the space
		    below has to separate the hero from the projects grid, while the space
		    above only has to clear the nav bar, which is already a ruled edge. */}
		<section class="pt-24 pb-28 text-center sm:pt-28 sm:pb-32">
			{/* Still capped at --measure so a wide viewport can't run the line out
			    past a readable length; mx-auto centres the box the cap creates. */}
			{/* --ink-hero, a step PAST the body ink away from the paper (2026-08-03,
			    Hiro: this line and the button should contrast more, closer to
			    white). It briefly went the other way, to --ink-soft, on a reading
			    of "lighter" as quieter — wrong, and the correction is worth
			    keeping: in the dark theme this line already sat near the top of
			    the range, so "lighter" could only have meant brighter.
			    This makes the sentence the highest-contrast text on the site,
			    ahead of body ink. That is the point — it is the page's opening
			    statement and the only thing above the rule — but it does mean the
			    hero now out-contrasts the wordmark, so if the mark ever needs to
			    lead again, it is this token it has to answer to. See --ink-hero in
			    global.css for why the two themes are proportional rather than
			    inverse. */}
			<p class="reveal mx-auto max-w-[var(--measure)] text-lg leading-relaxed text-[var(--ink-hero)]" style="--i: 0">
				I design product interfaces and then go build them.
			</p>
			{/* The page's only route to /about, so it's the site's one real button.
			    mt-6 rather than the old link's mt-4 — a control needs more air off
			    the line above it than a word set in the same size did.

			    The arrow is DRAWN AT REST and doesn't animate, unlike the project
			    cards' (which appear on hover). Different job: on a card the arrow
			    is a flourish on something already obviously clickable — bordered
			    image, whole-card cursor, a panel that lights up. Here it's the only
			    thing distinguishing a button that navigates from a button that
			    performs an action, and that's information you want before you
			    hover, not after. .btn's flex + gap owns the spacing, so the glyph
			    needs no margin of its own. */}
			<p class="reveal mt-6" style="--i: 1">
				<a href="/about" class="btn">
					About Hiro Eernisse
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
						class="inline-block h-[0.85rem] w-[0.85rem]"
					>
						<line x1="4" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</a>
			</p>
		</section>

		{/* Projects */}
		{/* The second of the page's two hairlines (2026-08-03, Hiro), the first
		    being the nav's own bottom edge. Drawn in global.css (#projects::before)
		    off the shared --rule gradient, which fades both of them out at their
		    ends — so they read as one device: the page is indexed into a bar, an
		    opening statement and a body of work.

		    This one is held to the CONTENT column rather than run full-bleed like
		    the nav's. Different jobs — the nav's line is the underside of a bar
		    that spans the viewport, while this one is a break inside the column,
		    and it lands on the same left edge as the leftmost card's year, the
		    wordmark above it and the copyright below. A full-bleed rule here would
		    read as a second bar rather than as a division of the text block.

		    The space is deliberately lopsided: the hero keeps its full breathing
		    room above the line, and the list opens at pt-12 below it, so the rule
		    belongs to the section it introduces rather than floating between two
		    equal gaps. */}
		<section id="projects" class="scroll-mt-20 pt-12 pb-16 sm:pt-14">
			{/* Two columns from sm up. The gaps are uneven on purpose: the column
			    gap only has to separate two cards side by side, while the row gap
			    also has to out-space the gap INSIDE a card (title → image), or a
			    card's image reads as belonging to the title below it. */}
			<div id="project-list" class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2">
				{/* The hover panel — one for the whole grid, sliding to whichever card
				    is hovered or focused. MUST STAY FIRST: it's kept under the cards by
				    DOM order as well as z-index (see .card-panel in global.css).
				    Absolutely positioned, so it claims no grid track. */}
				<div class="card-panel" aria-hidden="true"></div>
				{/* +2: the hero's two lines hold --i 0 and 1, so the whole page reveals
				    as one top-down cascade instead of the first cards arriving
				    alongside the hero. */}
				{projects.map((project, index) => (
					<div class="reveal" style={`--i: ${index + 2}`}>
						<ProjectCard project={project} />
					</div>
				))}
			</div>
		</section>
	</main>

	<footer class="mx-auto max-w-[960px] px-5 py-10 text-sm text-[var(--ink-soft)]">
		<span>© 2026 Hiro Eernisse</span>
	</footer>

</Layout>

{/* ── The travelling hover panel ──
    Drives .card-panel to whichever card is hovered or focused. Built on the
    same shape as the nav's contact pill (Nav.astro): a shared element that
    SLIDES between targets when one is already showing, and snaps into place
    with transitions suppressed when it first appears — otherwise the entrance
    animates from wherever the last card left it, or from 0,0 on the first
    hover, which reads as the panel flying in from the corner.

    All geometry comes from offsetLeft/Top/Width/Height, never
    getBoundingClientRect: offset values are the UNTRANSFORMED layout box. This
    mattered more when the card lifted 3px on hover — a rect read mid-transition
    had the panel chasing a moving target — and the card is still scaled while
    pressed, so the reason hasn't fully gone away. Keep it regardless: a panel
    that measures its target's transform will always be one gesture behind.

    But they must be ACCUMULATED up the offsetParent chain, not read once — see
    offsetIn below. A card's offsetParent is not #project-list: it's the .reveal
    wrapper in between, because .reveal runs a transform animation with
    fill-mode `both`, and an element with a filling transform animation is a
    containing block for as long as the fill lasts, which is forever. Read
    directly, every card reports the same offsetLeft/Top (-14, -14 — its own
    negative margin inside its wrapper) and the panel never leaves the first
    card. Accumulating also survives the opposite case: under html.reveal-skip
    the animation is off, .reveal stops being a containing block, and the walk
    simply has one less hop. */}
<script>
	const list = document.getElementById('project-list');
	const panel = list?.querySelector<HTMLElement>('.card-panel');

	if (list && panel) {
		const cards = Array.from(list.querySelectorAll<HTMLElement>('.project-card'));
		// The card no longer lifts on hover (2026-08-02), so the panel simply lands
		// on the card's own box. This used to read a --card-lift property off the
		// list and subtract it here, with a reduced-motion branch because the lift
		// was pinned to 0 under that setting and the two had to agree. All of it
		// came out with the lift; see the note in global.css if one comes back.
		let visible = false;
		let current: HTMLElement | null = null;

		// Sum offsetLeft/Top from `el` up to (not including) `root`, following the
		// offsetParent chain rather than the DOM parent chain. Terminates on the
		// root because #project-list is position: relative, so it is the first
		// positioned ancestor any chain from inside the grid can reach; the null
		// check is a guard against that ever changing silently.
		const offsetIn = (el: HTMLElement, root: HTMLElement) => {
			let x = 0;
			let y = 0;
			let node: HTMLElement | null = el;
			while (node && node !== root) {
				x += node.offsetLeft;
				y += node.offsetTop;
				node = node.offsetParent as HTMLElement | null;
			}
			return { x, y };
		};

		const place = (card: HTMLElement) => {
			const { x, y } = offsetIn(card, list);
			panel.style.width = `${card.offsetWidth}px`;
			panel.style.height = `${card.offsetHeight}px`;
			panel.style.transform = `translate(${x}px, ${y}px)`;
		};

		const show = (card: HTMLElement) => {
			current = card;
			if (visible) {
				// Slide + resize to the new card, and restart the compress that rides
				// along with it (see @keyframes panel-compress in global.css — the
				// panel gives up 3.5% of its size while it's moving). A CSS animation
				// only re-runs if it's removed and re-added with a reflow in between,
				// and the reflow has to happen while the class is OFF or the browser
				// coalesces the two states and the animation simply continues from
				// where the last hop left it. Placing after the flush keeps the
				// transform change and the animation start in the same frame.
				panel.classList.remove('is-sliding');
				void panel.offsetWidth;
				place(card);
				panel.classList.add('is-sliding');
				return;
			}
			// First appearance: kill the transition, land on the card, force the
			// reflow so the browser doesn't coalesce the two states, then let the
			// class fade it up. Only opacity animates here — and no compress, since
			// nothing has travelled: the panel is being placed, not moved.
			panel.classList.remove('is-sliding');
			panel.style.transition = 'none';
			place(card);
			void panel.offsetWidth;
			panel.style.transition = '';
			panel.classList.add('is-visible');
			visible = true;
		};

		const hide = () => {
			visible = false;
			current = null;
			panel.classList.remove('is-visible');
			// Drop the compress too, or a hop cut short by leaving the grid leaves a
			// part-compressed panel behind for the next appearance to snap in at.
			panel.classList.remove('is-sliding');
		};

		// Crossing the gutter between two cards briefly leaves every card, which
		// would hide the panel and re-show it at the new one — killing the slide
		// that is the whole point. A short grace delay lets the next enter cancel
		// the hide, so a sweep across the grid stays one continuous move; pausing
		// in the gutter still clears it.
		let gapHideTimer = 0;
		cards.forEach((card) => {
			card.addEventListener('mouseenter', () => {
				window.clearTimeout(gapHideTimer);
				show(card);
			});
			card.addEventListener('mouseleave', () => {
				window.clearTimeout(gapHideTimer);
				gapHideTimer = window.setTimeout(hide, 90);
			});
		});
		list.addEventListener('mouseleave', () => {
			window.clearTimeout(gapHideTimer);
			hide();
		});

		// Keyboard: the panel follows focus too, so tabbing through the grid marks
		// the same card the underline and the lift do.
		list.addEventListener('focusin', (e) => {
			const card = (e.target as HTMLElement).closest<HTMLElement>('.project-card');
			if (card) show(card);
		});
		list.addEventListener('focusout', (e) => {
			if (!list.contains(e.relatedTarget as Node)) hide();
		});

		// The grid reflows on resize (one column below sm), so every offset the
		// panel is holding goes stale. Re-place rather than hide — the pointer may
		// still be over the same card — and do it with transitions off, since the
		// panel isn't travelling anywhere, it's being corrected.
		window.addEventListener('resize', () => {
			if (!visible || !current) return;
			panel.style.transition = 'none';
			place(current);
			void panel.offsetWidth;
			panel.style.transition = '';
		});
	}
</script>

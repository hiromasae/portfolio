---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} — Hiro Eernisse`} description={project.blurb}>
	<Nav />

	<main class="mx-auto max-w-[1280px] px-5 py-12">
		{/* No back link up here on purpose: the nav is sticky, so its Projects
		    link never leaves the viewport, and a second one this close read as
		    two of the same control. The footer's does the job the nav link
		    can't — see there. */}

		{/* Dateline is the year alone — the company already reads off the prose
		    below, and tags/Visit were dropped from this page (both still live in
		    projects.ts). */}
		<header class="reveal" style="--i: 0">
			<p class="text-sm tabular-nums text-[var(--ink-soft)]">{project.year}</p>
			<h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{project.title}</h1>
		</header>

		{/* Reading matter is capped at --measure (see global.css) — ~11 words a
		    line — while the page itself spans the nav's full 1280px, which the
		    images below fill. */}
		<section class="reveal mt-8 max-w-[var(--measure)]" style="--i: 1">
			<h2 class="text-sm font-bold text-[var(--ink-soft)]">Background</h2>
			<p class="mt-3 text-lg leading-relaxed">{project.problem}</p>
		</section>

		<section class="reveal mt-8 max-w-[var(--measure)]" style="--i: 2">
			<h2 class="text-sm font-bold text-[var(--ink-soft)]">Work</h2>
			<p class="mt-3 text-lg leading-relaxed">{project.work}</p>
		</section>

		<section class="reveal mt-10 space-y-5" style="--i: 3">
			{
				project.images.map((src, i) => (
					<img
						src={src}
						alt={`${project.title} — image ${i + 1}`}
						loading={i === 0 ? 'eager' : 'lazy'}
						class="w-full rounded-[1.5px] border border-[var(--line)] bg-[var(--surface)]"
					/>
				))
			}
		</section>
	</main>

	{/* The one back link on the page, and not a duplicate of the nav's
	    Projects: the slug sends you to the CARD you came from at the scroll
	    position you left it (Nav.astro's nav-return / returnY), where the nav
	    link lands on the top of the list. Worth its place down here, several
	    thousand pixels of screenshots below where you started. */}
	<footer class="mx-auto max-w-[1280px] px-5 py-10">
		<a
			href={`/#project-${project.slug}`}
			data-projects-link
			data-project-slug={project.slug}
			class="btn-quiet"
		>
			{/* The card's arrow, mirrored — same viewBox and stroke, pointing the
			    other way. Decorative: the label carries the accessible name. */}
			<svg
				class="btn-quiet__arrow h-[0.9rem] w-[0.9rem]"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<line x1="20" y1="12" x2="5" y2="12"></line>
				<polyline points="12 5 5 12 12 19"></polyline>
			</svg>
			<span class="btn-quiet__label">Back to projects</span>
		</a>
	</footer>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} — Hiro Eernisse`} description={project.blurb}>
	<Nav />

	<main class="mx-auto max-w-[960px] px-5 py-12">
		{/* No back link up here on purpose. It used to be that the sticky nav's
		    Projects link never left the viewport, so a second one this close read
		    as two of the same control; that link is gone (08-01), and the reason
		    is now simply that the footer's does the job better — it returns you
		    to the card you came from, at the scroll position you left it. */}

		{/* Dateline is the year alone — the company already reads off the prose
		    below, and tags/Visit were dropped from this page (both still live in
		    projects.ts). */}
		<header class="reveal" style="--i: 0">
			<p class="text-sm tabular-nums text-[var(--ink-num)]">{project.year}</p>
			<h1 class="mt-2 text-3xl [font-weight:var(--weight-emph)] tracking-tight text-[var(--ink-title)] sm:text-4xl">{project.title}</h1>
		</header>

		{/* Reading matter is capped at --measure (see global.css) — ~11 words a
		    line — while the page itself spans the nav's full 960px, which the
		    images below fill.

		    No "Background" / "Work" headings: two paragraphs in one screen give
		    a reader nothing to skip to, and the labels were the same small-bold
		    kicker shape the home page dropped. The register change they marked
		    — context, then what I did — now rides the type instead. The problem
		    paragraph is set as a lead (a step up in size, --ink-soft), so the
		    work paragraph reads as the body it steps down into. */}
		<section class="reveal mt-8 max-w-[var(--measure)]" style="--i: 1">
			{/* Both paragraphs carry the UI weight tier (w400 dark / w500 light
			    since the 08-05 token pass; was font-normal) rather than inheriting
			    the body's tier — the only weight bumps the 2026-08-04 legibility
			    audit actually required. This is the site's longest-form reading, and at
			    w300 both fell under the APCA floor: the lead needs ≥32px at w300
			    for its Lc 64.8 and is 23.75px; the work paragraph needs ≥24px for
			    its Lc 75.1 and is 21.375px. w400 clears both.

			    ⚠ The dark lead is the site's one RESIDUAL APCA shortfall. The
			    08-05 AAA pass lifted --ink-soft to 7.06:1 (Lc 42.1 → 48.6), so
			    the lead is WCAG-AAA clean in both themes now — but APCA still
			    wants 35px at w400 from that Lc and the lead is 23.75px; no
			    weight reaches the floor from there. What remains is a COLOUR
			    gap, not a weight one: closing it fully means setting this
			    paragraph in --ink. Left standing deliberately — the muted lead
			    is the design, and it clears every WCAG bar it answers to. */}
			<p class="text-xl [font-weight:var(--weight-ui)] leading-relaxed text-[var(--ink-soft)]">{project.problem}</p>
			<p class="mt-6 text-lg [font-weight:var(--weight-ui)] leading-relaxed">{project.work}</p>
		</section>

		<section class="reveal mt-10 space-y-5" style="--i: 2">
			{/* Placeholder frames for a project whose screenshots don't exist yet.
			    Same border, radius and bed as the real images below, but at the
			    cards' 16/9 — a real screenshot sets its own height from the file,
			    and an empty div has none to take, so the ratio has to be stated.
			    They hold the page's shape (and the reveal's third beat) so
			    dropping the images in later is a data change, nothing more. */}
			{project.images.length === 0 &&
				Array.from({ length: project.placeholders ?? 0 }).map(() => (
					<div class="aspect-[16/9] w-full rounded-[var(--radius)] border border-[var(--line)] bg-[var(--surface-sunken)] bg-clip-padding" />
				))}
			{
				project.images.map((src, i) => (
					<img
						src={src}
						alt={`${project.title} — image ${i + 1}`}
						loading={i === 0 ? 'eager' : 'lazy'}
						class="w-full rounded-[var(--radius)] border border-[var(--line)] bg-[var(--surface)]"
					/>
				))
			}
		</section>
	</main>

	{/* The one back link on the page, and not a duplicate of the nav's
	    Projects: the slug sends you to the CARD you came from at the scroll
	    position you left it (Nav.astro's nav-return / returnY), where the nav
	    link lands on the top of the list. Worth its place down here, several
	    thousand pixels of screenshots below where you started. */}
	<footer class="mx-auto max-w-[960px] px-5 py-10">
		<a
			href={`/#project-${project.slug}`}
			data-projects-link
			data-project-slug={project.slug}
			class="btn-quiet"
		>
			{/* The card's arrow, mirrored — same viewBox and stroke, pointing the
			    other way. Decorative: the label carries the accessible name. */}
			<svg
				class="btn-quiet__arrow h-[0.9rem] w-[0.9rem]"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<line x1="20" y1="12" x2="5" y2="12"></line>
				<polyline points="12 5 5 12 12 19"></polyline>
			</svg>
			<span class="btn-quiet__label">Back to projects</span>
		</a>
	</footer>
</Layout>
